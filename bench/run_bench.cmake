# Runs every benchmark REPEAT times and prints the best time of each; fails
# when a benchmark does not run or reports a wrong result.
if(NOT BUILD_TYPE STREQUAL "Release")
  message(WARNING "benchmarks of a ${BUILD_TYPE} build: the runtime is not optimized, compare Release builds only")
endif()

file(STRINGS ${LIST} BENCHES)
set(table "")
set(total 0)
set(failed "")
foreach(exe ${BENCHES})
  set(best "")
  set(name "")
  set(check "")
  foreach(run RANGE 1 ${REPEAT})
    execute_process(COMMAND ${exe} OUTPUT_VARIABLE out RESULT_VARIABLE rc TIMEOUT 600)
    if(NOT rc EQUAL 0 OR NOT out MATCHES "([A-Za-z0-9_]+) +([0-9]+) +(ok|WRONG)")
      list(APPEND failed ${exe})
      set(check "failed")
      break()
    endif()
    set(name ${CMAKE_MATCH_1})
    set(check ${CMAKE_MATCH_3})
    if(best STREQUAL "" OR CMAKE_MATCH_2 LESS best)
      set(best ${CMAKE_MATCH_2})
    endif()
  endforeach()
  if(NOT check STREQUAL "ok")
    list(APPEND failed ${exe})
  endif()
  if(name STREQUAL "")
    get_filename_component(name ${exe} NAME_WE)
  endif()
  string(LENGTH "${name}" len)
  math(EXPR pad "12 - ${len}")
  if(pad LESS 0)
    set(pad 0)
  endif()
  string(REPEAT " " ${pad} spaces)
  string(LENGTH "${best}" len)
  math(EXPR pad2 "8 - ${len}")
  if(pad2 LESS 0)
    set(pad2 0)
  endif()
  string(REPEAT " " ${pad2} spaces2)
  string(APPEND table "${name}${spaces}${spaces2}${best}  ${check}\n")
  if(NOT best STREQUAL "")
    math(EXPR total "${total} + ${best}")
  endif()
endforeach()

message("benchmark   best ms  result\n${table}total       ${total} ms (best of ${REPEAT} runs each)")
if(failed)
  list(REMOVE_DUPLICATES failed)
  message(FATAL_ERROR "benchmarks that failed or gave a wrong result: ${failed}")
endif()
