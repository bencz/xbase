# Runs each pair of the primitives (the xBase program, its C counterpart) and prints, per primitive, the nanoseconds
# of each and their ratio.
file(STRINGS ${LIST} PAIRS)
foreach(pair ${PAIRS})
  string(REPLACE "|" ";" exes "${pair}")
  list(GET exes 0 xb)
  list(GET exes 1 c)
  execute_process(COMMAND ${xb} OUTPUT_VARIABLE xout RESULT_VARIABLE rc1 TIMEOUT 600)
  execute_process(COMMAND ${c} OUTPUT_VARIABLE cout RESULT_VARIABLE rc2 TIMEOUT 600)
  if(NOT rc1 EQUAL 0 OR NOT rc2 EQUAL 0)
    message(FATAL_ERROR "${pair} failed")
  endif()
  string(REPLACE "\n" ";" clines "${cout}")
  foreach(line ${clines})
    if(line MATCHES "^([a-z_0-9]+) +([0-9.]+)$")
      set(c_${CMAKE_MATCH_1} ${CMAKE_MATCH_2})
    endif()
  endforeach()
  message("primitive            xbase ns       C ns")
  string(REPLACE "\n" ";" xlines "${xout}")
  foreach(line ${xlines})
    if(line MATCHES "^([a-z_0-9]+) +([0-9.]+)$")
      set(n ${CMAKE_MATCH_1})
      string(LENGTH "${n}" len)
      math(EXPR pad "18 - ${len}")
      string(REPEAT " " ${pad} spaces)
      message("${n}${spaces} ${CMAKE_MATCH_2}   ${c_${n}}")
    endif()
  endforeach()
endforeach()
