# Writes OUT, a C++ source holding the runtime's xBase sources listed in SOURCES (a |-separated list) as byte arrays,
# with the public functions each one defines (FUNCTION or PROCEDURE at the start of a line, upper-cased): the compiler
# reads them to inline calls of those functions (driver/RuntimeLibrary.h).
string(REPLACE "|" ";" SOURCES "${SOURCES}")
set(arrays "")
set(entries "")
set(n 0)
foreach(src ${SOURCES})
  file(READ ${src} hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n    "
         bytes "${bytes}")
  string(APPEND arrays "const unsigned char kSource${n}[] = {\n    ${bytes}\n};\n")
  file(STRINGS ${src} heads REGEX "^(FUNCTION|PROCEDURE)[ \t]+[A-Za-z_][A-Za-z0-9_]*")
  set(names "")
  foreach(h ${heads})
    string(REGEX REPLACE "^(FUNCTION|PROCEDURE)[ \t]+([A-Za-z_][A-Za-z0-9_]*).*" "\\2" name "${h}")
    string(TOUPPER "${name}" name)
    string(APPEND names "\"${name}\", ")
  endforeach()
  get_filename_component(file ${src} NAME)
  string(APPEND entries "      {\"${file}\", std::string(reinterpret_cast<const char *>(kSource${n}), sizeof kSource${n}), {${names}}},\n")
  math(EXPR n "${n} + 1")
endforeach()
file(WRITE ${OUT}.tmp "// Generated by embed_sources.cmake: the runtime's xBase sources the compiler reads to inline their functions.
#include \"driver/RuntimeLibrary.h\"

namespace xb {

namespace {

${arrays}
} // namespace

const std::vector<EmbeddedSource> &runtimeLibrarySources() {
  static const std::vector<EmbeddedSource> sources = {
${entries}  };
  return sources;
}

} // namespace xb
")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUT}.tmp)
