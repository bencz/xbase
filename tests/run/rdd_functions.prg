// The database functions on one table: dbCreate, dbUseArea, dbAppend with a blank record, FieldPut and FieldGet of
// each type, FieldPos, FieldName, navigation (dbGoTop, dbGoBottom, dbSkip past either end, dbGoTo a record outside
// the table), dbDelete and dbRecall with SET DELETED, dbStruct, a filter, __dbLocate and __dbContinue, dbEval,
// RddName and dbCloseArea. The table is "rdd_functions.dbf", deleted at the end.
PROCEDURE Main()
   LOCAL a
   dbCreate( "rdd_functions", { { "NAME", "C", 10, 0 }, { "AGE", "N", 5, 1 }, { "BORN", "D", 8, 0 }, ;
      { "OK", "L", 1, 0 } } )
   dbUseArea( .T., , "rdd_functions" )
   ? "empty:", RecNo(), LastRec(), Bof(), Eof(), Alias(), Select(), Used(), FCount(), Header(), RecSize()
   dbAppend()
   ? "append:", RecNo(), LastRec(), Bof(), Eof(), "[" + FieldGet( 1 ) + "]", FieldGet( 2 ), FieldGet( 3 ), FieldGet( 4 )
   FieldPut( 1, "Ann" )
   FieldPut( 2, 12.34 )
   FieldPut( 3, SToD( "20240229" ) )
   FieldPut( 4, .T. )
   dbAppend()
   FieldPut( 1, "Bob" )
   FieldPut( 2, 999.9 )
   ? "fields:", FieldGet( 1 ), FieldGet( 2 ), FieldPos( "age" ), FieldName( 2 ), ValType( FieldGet( 3 ) ), ;
      Str( FieldGet( 2 ) )
   dbGoTop()
   ? "top:", RecNo(), Bof(), Eof(), FieldGet( 1 ), FieldGet( 2 ), FieldGet( 3 ), FieldGet( 4 )
   dbSkip( -1 )
   ? "skip -1:", RecNo(), Bof(), Eof(), FieldGet( 1 )
   dbGoBottom()
   dbSkip()
   ? "skip past:", RecNo(), Bof(), Eof(), "[" + FieldGet( 1 ) + "]", FieldGet( 2 )
   dbSkip()
   ? "skip again:", RecNo(), Eof()
   dbSkip( -1 )
   ? "back:", RecNo(), Eof(), FieldGet( 1 )
   dbGoTo( 1 )
   dbDelete()
   ? "deleted:", Deleted(), RecNo()
   Set( 11, .T. )
   dbGoTop()
   ? "set deleted top:", RecNo(), FieldGet( 1 )
   dbSkip( -1 )
   ? "skip -1 deleted:", RecNo(), Bof()
   Set( 11, .F. )
   a := dbStruct()
   ? "struct:", Len( a ), a[ 2 ][ 1 ], a[ 2 ][ 2 ], a[ 2 ][ 3 ], a[ 2 ][ 4 ]
   dbGoTo( 1 )
   dbRecall()
   ? "recall:", Deleted()
   dbGoTo( 9 )
   ? "goto 9:", RecNo(), Bof(), Eof()
   dbGoTo( 0 )
   ? "goto 0:", RecNo(), Bof(), Eof()
   dbSetFilter( {|| FieldGet( 2 ) > 100 }, "AGE > 100" )
   dbGoTop()
   ? "filter:", RecNo(), dbFilter(), FieldGet( 1 )
   dbClearFilter()
   __dbLocate( {|| FieldGet( 1 ) = "Bob" } )
   ? "locate:", Found(), RecNo()
   __dbContinue()
   ? "continue:", Found(), RecNo(), Eof()
   a := 0
   dbEval( {|| a += FieldGet( 2 ) } )
   ? "sum:", a, RddName(), RddSetDefault()
   dbCloseArea()
   ? "closed:", Used(), Alias(), Select()
   FErase( "rdd_functions.dbf" )
RETURN
