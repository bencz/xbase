// Every pair of values of every type (NIL, logical, integer, double, strings, dates, the empty ones, array, codeblock,
// hash, object) with every binary operator, and every value with the unary ones (-, .NOT., ++, --, an index), as a
// program meets them: values made at run time, the parameters of small functions (inlined), and macros. A result
// shows as its type and text; an error as E, its code and its operation. As the reference, but: an index on an
// object is the error of an index on a value that has no elements (the reference reads its variables), and in a
// macro an index on a literal is that run-time error too, as compiled (the reference rejects the text).
PROCEDURE Main()
   LOCAL aVal := {}, aText := {}
   AAdd( aVal, NIL )
   AAdd( aText, "NIL" )
   AAdd( aVal, .T. )
   AAdd( aText, ".T." )
   AAdd( aVal, 5 )
   AAdd( aText, "5" )
   AAdd( aVal, 2.5 )
   AAdd( aText, "2.5" )
   AAdd( aVal, "ab" )
   AAdd( aText, "'ab'" )
   AAdd( aVal, "" )
   AAdd( aText, "''" )
   AAdd( aVal, SToD( "20240229" ) )
   AAdd( aText, "SToD( '20240229' )" )
   AAdd( aVal, SToD( "" ) )
   AAdd( aText, "SToD( '' )" )
   AAdd( aVal, { 1 } )
   AAdd( aText, "{ 1 }" )
   AAdd( aVal, {|| 1 } )
   AAdd( aText, "{|| 1 }" )
   AAdd( aVal, { "k" => 1 } )
   AAdd( aText, "{ 'k' => 1 }" )
   AAdd( aVal, ErrorNew() )
   AAdd( aText, "ErrorNew()" )
   ErrorBlock( {| e | Break( e ) } )
   BinaryAdd( aVal, aText )
   BinarySub( aVal, aText )
   BinaryMul( aVal, aText )
   BinaryDiv( aVal, aText )
   BinaryMod( aVal, aText )
   BinaryPow( aVal, aText )
   BinaryEeq( aVal, aText )
   BinaryEq( aVal, aText )
   BinaryNe( aVal, aText )
   BinaryLt( aVal, aText )
   BinaryLe( aVal, aText )
   BinaryGt( aVal, aText )
   BinaryGe( aVal, aText )
   BinaryHas( aVal, aText )
   Unary( aVal, aText )
RETURN

STATIC PROCEDURE BinaryAdd( aVal, aText )
   LOCAL a, b, i, j
   ? "runtime +"
   FOR EACH a IN aVal
      ? ""
      FOR EACH b IN aVal
         ?? " " + Shown( {|| a + b } )
      NEXT
   NEXT
   ? "inlined +"
   ? ""
   ?? " " + Shown( {|| Add( NIL, NIL ) } )
   ?? " " + Shown( {|| Add( NIL, .T. ) } )
   ?? " " + Shown( {|| Add( NIL, 5 ) } )
