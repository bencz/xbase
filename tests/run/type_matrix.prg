STATIC PROCEDURE Unary( aVal, aText )
   LOCAL a, x, c
   ? "unary runtime"
   FOR EACH a IN aVal
      x := a
      ? Shown( {|| -a } ), Shown( {|| .NOT. a } ), Shown( {|| ++x } ), Shown( {|| x-- } ), Shown( {|| x } ), ;
         Shown( {|| a[ 1 ] } )
   NEXT
   ? "unary macro"
   FOR EACH c IN aText
      ? Shown( {|| &( "-" + c ) } ), Shown( {|| &( ".NOT. " + c ) } ), Shown( {|| &( "(" + c + ")[ 1 ]" ) } )
   NEXT
RETURN

// The value a block gives, as its type and text, or E, the code and the operation of its error.
STATIC FUNCTION Shown( b )
   LOCAL x, e
   BEGIN SEQUENCE
      x := Eval( b )
   RECOVER USING e
      RETURN "E" + LTrim( Str( e:subCode ) ) + e:operation
   END SEQUENCE
RETURN Text( x )

STATIC FUNCTION Text( x )
   SWITCH ValType( x )
   CASE "N"
      RETURN "N" + LTrim( Str( x ) )
   CASE "C"
      RETURN "C'" + x + "'"
   CASE "L"
      RETURN iif( x, "T", "F" )
   CASE "D"
      RETURN "D" + DToS( x )
   ENDSWITCH
RETURN ValType( x )

