// Every pair of number values with every arithmetic and comparison operator, as the four ways a program meets
// them: literals (folded when compiled), elements of an array made at run time (the operators at run time), the
// parameters of small functions called with literals (inlined and folded), and values read from the command line
// with Val(). Each line shows a value against all of them; a division by zero shows what the error handler gives.
// As the reference, but for products beyond 2^53: xbase shows their 16 correctly rounded digits (docs/runtime.md).
PROCEDURE Main( ... )
   LOCAL aVal := {}, aIn := {}, i, j, aArgs := { ... }
   ErrorBlock( {| e | iif( e:canSubstitute, 0, Break( e ) ) } )
   AAdd( aVal, 0 )
   AAdd( aVal, 1 )
   AAdd( aVal, -1 )
   AAdd( aVal, 5 )
   AAdd( aVal, 2.01 )
   AAdd( aVal, -2.5 )
   AAdd( aVal, 0.1 )
   AAdd( aVal, 3.14159 )
   AAdd( aVal, 999999999 )
   AAdd( aVal, 1000000000 )
   AAdd( aVal, 9999999999 )
   AAdd( aVal, 123456789012 )
   FOR EACH i IN aArgs
      AAdd( aIn, Val( i ) )
   NEXT
   ? "literal +"
   ?? 0 + 0, 0 + 1, 0 + ( -1 ), 0 + 5, 0 + 2.01, 0 + ( -2.5 ), 0 + 0.1, 0 + 3.14159, 0 + 999999999, 0 + 1000000000, ""
   ?? 0 + 9999999999, 0 + 123456789012
   ?
   ?? 1 + 0, 1 + 1, 1 + ( -1 ), 1 + 5, 1 + 2.01, 1 + ( -2.5 ), 1 + 0.1, 1 + 3.14159, 1 + 999999999, 1 + 1000000000, ""
