STATIC FUNCTION Shown( b )
   LOCAL x, e
   BEGIN SEQUENCE WITH {| o | Break( o ) }
      x := Eval( b )
   RECOVER USING e
      RETURN " E" + LTrim( Str( e:subCode ) )
   END SEQUENCE
RETURN "[" + x + "]"
