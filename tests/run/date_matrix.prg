// Two-digit years under each SET EPOCH.
STATIC PROCEDURE Epochs()
   LOCAL n, c
   SET DATE AMERICAN
   SET CENTURY OFF
   FOR EACH n IN { 1900, 1950, 1980, 2000, 2050, 0 }
      SET EPOCH TO n
      ? "epoch", Set( _SET_EPOCH )
      FOR EACH c IN { "12/31/49", "01/01/50", "12/31/79", "01/01/80", "01/01/99", "01/01/00", "06/15/01" }
         ?? " " + DToS( CToD( c ) )
      NEXT
   NEXT
   SET EPOCH TO 1900
RETURN
