// Dates through every function, operator and setting that handles them, over a list of dates (the empty date, the
// first and last days the type holds, the Gregorian switch, century and leap-year edges) and of day counts
// (negative, fractional, past the range), as a program meets them: SToD() of literals, values made at run time,
// macros compiled from text, and dates read from the command line (<> stands for the empty date). Then DToC() and
// CToD() under each SET DATE and SET CENTURY, CToD() of valid and invalid text, and SET EPOCH.
PROCEDURE Main( ... )
   LOCAL aDate := {}, aText := {}, aIn := {}, cArg, aNum := { -36525, -366, -1, 0, 1, 1.9, -1.9, 0.5, 366, 2958465 }
   AAdd( aDate, SToD( "" ) )
   AAdd( aText, "SToD( '' )" )
   AAdd( aDate, SToD( "00010101" ) )
   AAdd( aText, "SToD( '00010101' )" )
   AAdd( aDate, SToD( "15821004" ) )
   AAdd( aText, "SToD( '15821004' )" )
   AAdd( aDate, SToD( "15821015" ) )
   AAdd( aText, "SToD( '15821015' )" )
   AAdd( aDate, SToD( "18991231" ) )
   AAdd( aText, "SToD( '18991231' )" )
   AAdd( aDate, SToD( "19000228" ) )
   AAdd( aText, "SToD( '19000228' )" )
   AAdd( aDate, SToD( "19000301" ) )
   AAdd( aText, "SToD( '19000301' )" )
   AAdd( aDate, SToD( "19700101" ) )
   AAdd( aText, "SToD( '19700101' )" )
   AAdd( aDate, SToD( "19991231" ) )
   AAdd( aText, "SToD( '19991231' )" )
   AAdd( aDate, SToD( "20000229" ) )
   AAdd( aText, "SToD( '20000229' )" )
   AAdd( aDate, SToD( "20000301" ) )
   AAdd( aText, "SToD( '20000301' )" )
   AAdd( aDate, SToD( "20230228" ) )
   AAdd( aText, "SToD( '20230228' )" )
   AAdd( aDate, SToD( "20240229" ) )
   AAdd( aText, "SToD( '20240229' )" )
   AAdd( aDate, SToD( "20241231" ) )
   AAdd( aText, "SToD( '20241231' )" )
   AAdd( aDate, SToD( "99991231" ) )
   AAdd( aText, "SToD( '99991231' )" )
   FOR EACH cArg IN { ... }
      AAdd( aIn, SToD( iif( cArg == "<>", "", cArg ) ) )
   NEXT
   SET DATE ANSI
   SET CENTURY ON
   Parts( aDate, aText, aIn )
   Sums( aDate, aText, aIn, aNum )
   Pairs( aDate, aText, aIn )
   Formats( aDate )
   Epochs()
RETURN

// Each date as its parts.
STATIC PROCEDURE Parts( aDate, aText, aIn )
   LOCAL d
   ? "parts literal"
   ? Part( SToD( "" ) )
   ? Part( SToD( "00010101" ) )
   ? Part( SToD( "15821004" ) )
   ? Part( SToD( "15821015" ) )
   ? Part( SToD( "18991231" ) )
   ? Part( SToD( "19000228" ) )
   ? Part( SToD( "19000301" ) )
   ? Part( SToD( "19700101" ) )
   ? Part( SToD( "19991231" ) )
   ? Part( SToD( "20000229" ) )
   ? Part( SToD( "20000301" ) )
   ? Part( SToD( "20230228" ) )
   ? Part( SToD( "20240229" ) )
   ? Part( SToD( "20241231" ) )
   ? Part( SToD( "99991231" ) )
   ? "parts runtime"
   FOR EACH d IN aDate
      ? Part( d )
   NEXT
   ? "parts macro"
   FOR EACH d IN aText
      ? Part( &d )
   NEXT
   ? "parts input"
   FOR EACH d IN aIn
      ? Part( d )
   NEXT
RETURN

STATIC FUNCTION Part( d )
RETURN DToS( d ) + "|" + DToC( d ) + "|" + Str( Year( d ), 5 ) + Str( Month( d ), 3 ) + Str( Day( d ), 3 ) + ;
   Str( DoW( d ), 2 ) + "|" + CDoW( d ) + "|" + CMonth( d ) + "|" + iif( Empty( d ), "E", "-" ) + ValType( d )

