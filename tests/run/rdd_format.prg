// The DBF format against the reference's bytes: a table the reference wrote (its bytes below, in hexadecimal) reads
// back with its values, sizes and deletion flags; the same table made here (dbCreate, APPEND BLANK, REPLACE, DELETE)
// is the same bytes but the date of the last update; a character field longer than 255 keeps its length in the
// decimals byte. The files start with "rdd_format_" and are deleted at the end.
PROCEDURE Main()
   FIELD NAME, QTY, WHEN, OK, BIG
   LOCAL cHex := "", cOracle, h, cMine
   cHex += "03630C1F03000000C200440100000000000000000000000000000000000000004E414D450000000000000043000000000800"
   cHex += "000000000000000000000000000051545900000000000000004E00000000060200000000000000000000000000005748454E"
   cHex += "000000000000004400000000080000000000000000000000000000004F4B0000000000000000004C00000000010000000000"
   cHex += "00000000000000000000424947000000000000000043000000002C0100000000000000000000000000000D0020416E6E2020"
   cHex += "202020202D312E35303139393931323331547820202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "20202020202020202020202020202020202020426F6220202020203132332E34362020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202A20202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "2020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020"
   cHex += "202020202020202020202020202020201A"
   cOracle := Bytes( cHex )
   h := FCreate( "rdd_format_ref.dbf" )
   FWrite( h, cOracle )
   FClose( h )
   USE rdd_format_ref NEW READONLY
   ? "read:", LastRec(), Header(), RecSize(), FCount(), DToS( LUpdate() )
   DO WHILE ! Eof()
      ? RecNo(), "[" + NAME + "]", QTY, DToS( WHEN ), OK, Len( BIG ), "[" + Left( BIG, 2 ) + "]", Deleted()
      SKIP
   ENDDO
   CLOSE
   dbCreate( "rdd_format_mine", { { "NAME", "C", 8, 0 }, { "QTY", "N", 6, 2 }, { "WHEN", "D", 8, 0 }, ;
      { "OK", "L", 1, 0 }, { "BIG", "C", 300, 0 } } )
   USE rdd_format_mine NEW
   APPEND BLANK
   REPLACE NAME WITH "Ann", QTY WITH -1.5, WHEN WITH SToD( "19991231" ), OK WITH .T., BIG WITH "x"
   APPEND BLANK
   REPLACE NAME WITH "Bob", QTY WITH 123.456
   APPEND BLANK
   DELETE
   CLOSE
   cMine := MemoRead( "rdd_format_mine.dbf" ) + Chr( 26 ) // MemoRead drops the end mark
   ? "same bytes but the date:", Len( cMine ) == Len( cOracle ), Left( cMine, 1 ) == Left( cOracle, 1 ), ;
      SubStr( cMine, 5 ) == SubStr( cOracle, 5 )
   FErase( "rdd_format_ref.dbf" )
   FErase( "rdd_format_mine.dbf" )
RETURN

STATIC FUNCTION Bytes( cHex )
   LOCAL c := "", i
   FOR i := 1 TO Len( cHex ) STEP 2
      c += Chr( Digit( SubStr( cHex, i, 1 ) ) * 16 + Digit( SubStr( cHex, i + 1, 1 ) ) )
   NEXT
RETURN c

STATIC FUNCTION Digit( c )
RETURN At( c, "0123456789ABCDEF" ) - 1
