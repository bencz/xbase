RETURN

STATIC PROCEDURE Put( cFile, cBytes )
   LOCAL h := FCreate( cFile )
   FWrite( h, cBytes )
   FClose( h )
RETURN

// The file's bytes (MemoRead() would drop a last 0x1A).
STATIC FUNCTION Get( cFile )
   LOCAL h := FOpen( cFile ), n := FSeek( h, 0, 2 ), c := Space( n )
   FSeek( h, 0 )
   FRead( h, @c, n )
   FClose( h )
RETURN c

STATIC FUNCTION Bytes( cHex )
   LOCAL c := "", i
   FOR i := 1 TO Len( cHex ) STEP 2
      c += Chr( Digit( SubStr( cHex, i, 1 ) ) * 16 + Digit( SubStr( cHex, i + 1, 1 ) ) )
   NEXT
RETURN c

STATIC FUNCTION Digit( c )
RETURN At( c, "0123456789ABCDEF" ) - 1
