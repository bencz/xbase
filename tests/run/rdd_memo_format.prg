   CLOSE
   cMine := MemoRead( "rdd_memo_format_mine.dbf" ) + Chr( 26 ) // MemoRead drops the end mark
   ? "same table but the date:", Left( cMine, 1 ) == Left( Bytes( cDbf ), 1 ), ;
      SubStr( cMine, 5 ) == SubStr( Bytes( cDbf ), 5 )
   ? "same memo file:", Get( "rdd_memo_format_mine.dbt" ) == Bytes( cDbt )
   FErase( "rdd_memo_format_ref.dbf" )
