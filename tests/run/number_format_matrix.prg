   ? ""
   ?? "[" + Str( -1 ) + "]"
   ? ""
   ?? "[" + Str( 0.5 ) + "]"
   ? ""
   ?? "[" + Str( -0.5 ) + "]"
   ? ""
   ?? "[" + Str( 1.5 ) + "]"
   ? ""
   ?? "[" + Str( 2.5 ) + "]"
   ? ""
   ?? "[" + Str( 0.125 ) + "]"
   ? ""
   ?? "[" + Str( 2.675 ) + "]"
   ? ""
   ?? "[" + Str( 123.456 ) + "]"
   ? ""
   ?? "[" + Str( -123.456 ) + "]"
   ? ""
   ?? "[" + Str( 99.995 ) + "]"
   ? ""
   ?? "[" + Str( 0.0001 ) + "]"
   ? ""
   ?? "[" + Str( 999999999 ) + "]"
   ? ""
   ?? "[" + Str( 1000000000 ) + "]"
   ? ""
   ?? "[" + Str( -9999999999 ) + "]"
   ? ""
   ?? "[" + Str( 123456789.123 ) + "]"
   ? ""
   ?? "[" + Str( 1000000000000000 ) + "]"
   ? "Str(v) runtime"
   FOR EACH x0 IN aVal
      ? ""
      ?? "[" + Str( x0 ) + "]"
   NEXT
   ? "Str(v) macro"
   FOR EACH x0 IN aText
      ? ""
      ?? "[" + &( "Str( " + x0 + " )" ) + "]"
   NEXT
   ? "Str(v) input"
   FOR EACH x0 IN aIn
      ? ""
      ?? "[" + Str( x0 ) + "]"
   NEXT
RETURN

