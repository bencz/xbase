   ?? "[" + Str( 1000000000 * 1 ) + "]"
   ? ""
   ?? "[" + Str( -9999999999 * 1 ) + "]"
   ? ""
   ?? "[" + Str( 123456789.123 * 1 ) + "]"
   ? ""
   ?? "[" + Str( 1000000000000000 * 1 ) + "]"
   ? "Default(v) runtime"
   FOR EACH x0 IN aVal
      ? ""
      ?? "[" + Str( x0 * 1 ) + "]"
   NEXT
   ? "Default(v) macro"
   FOR EACH x0 IN aText
      ? ""
      ?? "[" + &( "Str( " + x0 + " * 1 )" ) + "]"
   NEXT
   ? "Default(v) input"
   FOR EACH x0 IN aIn
      ? ""
      ?? "[" + Str( x0 * 1 ) + "]"
   NEXT
RETURN

