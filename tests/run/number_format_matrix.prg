// The quotients under SET DECIMALS.
STATIC PROCEDURE Settings( aVal )
   LOCAL x, n
   FOR EACH n IN { 0, 2, 4, 9 }
      SET DECIMALS TO n
      ? "decimals", n
      FOR EACH x IN aVal
         ?? "[" + Str( x / 3 ) + "|" + Str( x / 4 ) + "]"
      NEXT
   NEXT
   SET DECIMALS TO 2
RETURN
