// Numbers as text: Str() with no width, a width, a width and decimals; Round(), Int(), Abs(), Transform() with
// number pictures, Val() of what Str() gives, the default display of a product, a quotient and a negation; over
// a list of numbers (signs, halves, values just below a rounding step, the display widths' limits, past 15
// digits), as a program meets them: literal arguments, values made at run time, macros compiled from text, and
// Val() of the command line. Then SET DECIMALS on the quotients. Results are shown between brackets.
PROCEDURE Main( ... )
   LOCAL aVal := {}, aText := {}, aIn := {}, cArg
   AAdd( aVal, 0 )
   AAdd( aText, "0" )
   AAdd( aVal, 1 )
   AAdd( aText, "1" )
   AAdd( aVal, -1 )
   AAdd( aText, "-1" )
   AAdd( aVal, 0.5 )
   AAdd( aText, "0.5" )
   AAdd( aVal, -0.5 )
   AAdd( aText, "-0.5" )
   AAdd( aVal, 1.5 )
   AAdd( aText, "1.5" )
   AAdd( aVal, 2.5 )
   AAdd( aText, "2.5" )
   AAdd( aVal, 0.125 )
   AAdd( aText, "0.125" )
   AAdd( aVal, 2.675 )
   AAdd( aText, "2.675" )
   AAdd( aVal, 123.456 )
   AAdd( aText, "123.456" )
   AAdd( aVal, -123.456 )
   AAdd( aText, "-123.456" )
   AAdd( aVal, 99.995 )
   AAdd( aText, "99.995" )
   AAdd( aVal, 0.0001 )
   AAdd( aText, "0.0001" )
   AAdd( aVal, 999999999 )
   AAdd( aText, "999999999" )
   AAdd( aVal, 1000000000 )
   AAdd( aText, "1000000000" )
   AAdd( aVal, -9999999999 )
   AAdd( aText, "-9999999999" )
   AAdd( aVal, 123456789.123 )
   AAdd( aText, "123456789.123" )
   AAdd( aVal, 1000000000000000 )
   AAdd( aText, "1000000000000000" )
   FOR EACH cArg IN { ... }
      AAdd( aIn, Val( cArg ) )
   NEXT
   N00( aVal, aText, aIn )
   N01( aVal, aText, aIn )
   N02( aVal, aText, aIn )
   N03( aVal, aText, aIn )
   N04( aVal, aText, aIn )
   N05( aVal, aText, aIn )
   N06( aVal, aText, aIn )
   N07( aVal, aText, aIn )
   N08( aVal, aText, aIn )
   N09( aVal, aText, aIn )
   N10( aVal, aText, aIn )
   Settings( aVal )
RETURN

