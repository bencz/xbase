# A library's stamp: a program's object compiled with a library links with that library (xbc given the object),
# and no longer once the library is rebuilt from other sources (the link error names the stamp it requires). XBC,
# TARGET (xbc's target or empty), WORKDIR.
set(dir ${WORKDIR}/library_stamp)
file(REMOVE_RECURSE ${dir})
file(MAKE_DIRECTORY ${dir}/lib)
file(WRITE ${dir}/lib/stamped.xbprj "type = library\nsources = stamped.prg\n")
file(WRITE ${dir}/lib/stamped.prg "FUNCTION One()\nRETURN 1\n")
file(WRITE ${dir}/main.prg "PROCEDURE Main()\n   ? One()\nRETURN\n")
set(target "")
if(TARGET)
  set(target --target=${TARGET})
endif()
function(run what)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(rc ${rc} PARENT_SCOPE)
  set(err "${out}${err}" PARENT_SCOPE)
  if(what STREQUAL "must" AND NOT rc EQUAL 0)
    message(FATAL_ERROR "failed: ${ARGN}\n${out}${err}")
  endif()
endfunction()
set(link ${XBC} ${dir}/main.o --lib=stamped -L${dir}/lib -o ${dir}/main ${target})
run(must ${XBC} ${dir}/lib/stamped.xbprj --out-dir=${dir}/lib ${target})
run(must ${XBC} -c ${dir}/main.prg --lib=stamped -L${dir}/lib -o ${dir}/main.o ${target})
run(must ${link})
file(WRITE ${dir}/lib/stamped.prg "FUNCTION One()\nRETURN 2\n")
run(must ${XBC} ${dir}/lib/stamped.xbprj --out-dir=${dir}/lib ${target})
run(may ${link})
if(rc EQUAL 0)
  message(FATAL_ERROR "the program compiled with the old library linked with the new one")
endif()
if(NOT err MATCHES "xbx_STAMPED\\$source\\$[0-9a-f]+")
  message(FATAL_ERROR "the link failed without naming the library's stamp:\n${err}")
endif()
file(REMOVE_RECURSE ${dir})
