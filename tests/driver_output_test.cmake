# What xbc writes by default (docs/projects.md): a program's sources linked into the program named after the first
# (in the current folder), with -c its object beside it and no program, a project's object (-c) in its output folder;
# object files given with -c, and -c with --library, are errors. XBC, TARGET (xbc's target or empty), SUFFIX (the
# target's program suffix), WORKDIR.
set(dir ${WORKDIR}/driver_output)
file(REMOVE_RECURSE ${dir})
file(MAKE_DIRECTORY ${dir}/src)
file(WRITE ${dir}/src/hello.prg "PROCEDURE Main()\n   ? 'hello'\nRETURN\n")
file(WRITE ${dir}/src/hello.xbprj "name = greeting\nsources = hello.prg\n")
set(target "")
if(TARGET)
  set(target --target=${TARGET})
endif()
function(run what)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY ${dir} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(out "${out}" PARENT_SCOPE)
  set(err "${err}" PARENT_SCOPE)
  if(what STREQUAL "must" AND NOT rc EQUAL 0)
    message(FATAL_ERROR "failed: ${ARGN}\n${out}${err}")
  elseif(what STREQUAL "fails" AND rc EQUAL 0)
    message(FATAL_ERROR "did not fail: ${ARGN}\n${out}${err}")
  endif()
endfunction()
function(expect file present)
  if(present AND NOT EXISTS ${file})
    message(FATAL_ERROR "missing: ${file}")
  elseif(NOT present AND EXISTS ${file})
    message(FATAL_ERROR "written: ${file}")
  endif()
endfunction()

run(must ${XBC} src/hello.prg ${target})
expect(${dir}/hello${SUFFIX} ON)
expect(${dir}/src/hello.o OFF)
run(must ${dir}/hello${SUFFIX})
if(NOT out MATCHES "hello")
  message(FATAL_ERROR "the program printed: ${out}")
endif()

file(REMOVE ${dir}/hello${SUFFIX})
run(must ${XBC} -c src/hello.prg ${target})
expect(${dir}/src/hello.o ON)
expect(${dir}/hello${SUFFIX} OFF)

run(must ${XBC} -c src/hello.xbprj --out-dir=out ${target})
expect(${dir}/out/greeting.o ON)
expect(${dir}/out/greeting${SUFFIX} OFF)

run(fails ${XBC} -c src/hello.o -o again.o ${target})
if(NOT err MATCHES "object files are linked into a program")
  message(FATAL_ERROR "objects with -c: ${err}")
endif()
run(fails ${XBC} -c --library=hello src/hello.prg ${target})
if(NOT err MATCHES "--library makes a library: no -c")
  message(FATAL_ERROR "-c with --library: ${err}")
endif()
