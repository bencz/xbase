module SEQUENCE

function MAIN params 1 {
  $f0 = frame 0 "N"
  $f1 = frame 1 "X"
  $f2 = frame 2 "N"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward MAIN.byref
  ret %2
body:
  %4 = load $f0
  store $f2, %4
  store $f1, 1:w10
  br seq.body
seq.body unwind seq.unwind:
  %8 = load $f2
  %9 = binary div 10:w10, %8
  store $f1, %9
  br seq.end
seq.unwind:
  %12 = seq.catch
  cond_br %12, seq.recover, seq.onward
seq.end:
  %14 = load $f1
  ret %14
seq.recover:
  %16 = seq.value
  store $f1, %16
  %18 = load $f1
  %19 = unary neg %18
  store $f1, %19
  br seq.end
seq.onward:
  ret
}

function MAIN.byref internal params 1 {
  $f0 = frame 0 "N"
  $f1 = frame 1 "X"
entry:
  store $f1, 1:w10
  br seq.body
seq.body unwind seq.unwind:
  %2 = load $f0 maybe_ref
  %3 = binary div 10:w10, %2
  store $f1, %3
  br seq.end
seq.unwind:
  %6 = seq.catch
  cond_br %6, seq.recover, seq.onward
seq.end:
  %8 = load $f1
  ret %8
seq.recover:
  %10 = seq.value
  store $f1, %10
  %12 = load $f1
  %13 = unary neg %12
  store $f1, %13
  br seq.end
seq.onward:
  ret
}
