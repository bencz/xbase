module INLINE_FUNCTIONS

function MAIN params 1 {
  $f0 = frame 0 shared "N"
  $f3 = frame 3 "X"
entry:
  %0 = load $f0 maybe_ref
  inline.enter SQ
  %2 = binary mul %0, %0
  inline.leave
  %4 = ref $f0
  inline.enter BUMP.byref
  store $f3, %4
  %7 = load $f3 maybe_ref
  %8 = binary add.one %7, 1:w0
  store $f3 maybe_ref, %8
  barrier $f3 maybe_ref
  store $f3, nil
  inline.leave
  %13 = load $f0 maybe_ref
  %14 = binary add %2, %13
  %15 = call FACT 3:w10
  %16 = binary add %14, %15
  ret %16
}

function SQ internal params 1 {
  $f0 = frame 0 "X"
entry:
  %0 = load $f0
  %1 = binary mul %0, %0
  ret %1
}

function BUMP internal params 1 {
  $f0 = frame 0 "X"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward BUMP.byref
  ret %2
body:
  %4 = load $f0
  %5 = binary add.one %4, 1:w0
  ret
}

function FACT internal params 1 {
  $f0 = frame 0 "K"
entry:
  %0 = load $f0
  %1 = binary le %0, 1:w10
  %2 = truth %1
  cond_br %2, iif.end(1:w10), iif.else
iif.else:
  %4 = binary sub %0, 1:w10
  %5 = call FACT %4
  %6 = binary mul %0, %5
  br iif.end(%6)
iif.end(%8: item):
  ret %8
}

function BUMP.byref internal params 1 {
  $f0 = frame 0 "X"
entry:
  %0 = load $f0 maybe_ref
  %1 = binary add.one %0, 1:w0
  store $f0 maybe_ref, %1
  barrier $f0 maybe_ref
  ret
}
