module FOREACH_BLOCK

function MAIN params 1 {
  $f0 = frame 0 "ALIST"
  $f1 = frame 1 "E"
  $f2 = frame 2 shared "N"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward MAIN.byref
  ret %2
body:
  %4 = load $f0 move
  store $f2 maybe_ref, 0:w10
  barrier $f2 maybe_ref
  %7 = each.source %4, false
  %8 = subst.check guard 16 %7
  cond_br %8, body.2.other, body.2
each.test(%10: i64):
  %11 = i.add %10, i64 1
  %12 = enum.len %7
  %13 = i.cmp le %11, %12
  cond_br %13, each.body, each.end(%33)
each.body:
  %15 = i.add %10, i64 1
  each.move $f1, false, %15, %7
  %17 = load $f2 maybe_ref
  %18 = load $f1 ref
  %19 = binary add.grow %17, %18
  store $f2 maybe_ref, %19
  barrier $f2 maybe_ref
  %22 = i.add %10, i64 1
