each.end(%24: item):
  each.leave $f1, false, %24
  %26 = block MAIN.block2 $f2
  inline.enter MAIN.block2
  %28 = load $f2 maybe_ref
  %29 = binary mul 2:w10, %28
  inline.leave
  %31 = array %29, %26
  ret %31
body.2:
  %33 = each.enter $f1, false, %7
  br each.test(i64 0)
body.2.other:
  %35 = subst.value %7
  %36 = subst.check guard 32 %35
  cond_br %36, body.2.other.2, body.2.each1
body.2.each1:
  %38 = each.enter $f1, false, %35
  br each.test.each1(i64 0)
each.test.each1(%40: i64):
  %41 = i.add %40, i64 1
  %42 = enum.len %35
  %43 = i.cmp le %41, %42
  cond_br %43, each.body.each1, each.end(%38)
each.body.each1:
  %45 = i.add %40, i64 1
  each.move $f1, false, %45, %35
  %47 = load $f2 maybe_ref
  %48 = load $f1 ref
  %49 = binary add.grow %47, %48
  store $f2 maybe_ref, %49
  barrier $f2 maybe_ref
  %52 = i.add %40, i64 1
  br each.test.each1(%52)
body.2.other.2:
  %54 = subst.value %35
  %55 = each.enter $f1, false, %54
  br each.test.each(i64 0)
each.test.each(%57: i64):
  %58 = i.add %57, i64 1
  %59 = enum.len %54
  %60 = i.cmp le %58, %59
  cond_br %60, each.body.each, each.end(%55)
each.body.each:
  %62 = i.add %57, i64 1
  each.move $f1, false, %62, %54
  %64 = load $f2 maybe_ref
  %65 = load $f1 ref
  %66 = binary add.grow %64, %65
  store $f2 maybe_ref, %66
  barrier $f2 maybe_ref
  %69 = i.add %57, i64 1
  br each.test.each(%69)
}

