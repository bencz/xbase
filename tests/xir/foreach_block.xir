module FOREACH_BLOCK

function MAIN params 1 {
  $f0 = frame 0 "ALIST"
  $f1 = frame 1 "E"
  $f2 = frame 2 shared "N"
  $f3 = frame 3 "B"
  $f4 = frame 4 "ALIST"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward MAIN.byref
  ret %2
body:
  %4 = load $f0
  store $f2 maybe_ref, 0:w10
  barrier $f2 maybe_ref
  %7 = each.source %4, false
  %8 = each.enter $f1, false, %7
  br each.test(i64 0)
each.test(%10: i64):
  %11 = i.add %10, i64 1
  %12 = enum.len %7
  %13 = i.cmp le %11, %12
  cond_br %13, each.body, each.end
each.body:
  %15 = i.add %10, i64 1
  each.move $f1, false, %15
  %17 = load $f2 maybe_ref
  %18 = load $f1 ref
  %19 = binary add %17, %18
  store $f2 maybe_ref, %19
  barrier $f2 maybe_ref
  %22 = i.add %10, i64 1
  br each.test(%22)
each.end:
  each.leave $f1, false, %8
  %25 = block MAIN.block2 $f2
  %26 = call EVAL native %25, 2:w10
  ret %26
}

function MAIN.byref internal params 1 {
  $f0 = frame 0 "ALIST"
  $f1 = frame 1 "E"
  $f2 = frame 2 shared "N"
  $f3 = frame 3 "B"
entry:
  store $f2 maybe_ref, 0:w10
  barrier $f2 maybe_ref
  %2 = load $f0 maybe_ref
  %3 = each.source %2, false
  %4 = each.enter $f1, false, %3
  br each.test(i64 0)
each.test(%6: i64):
  %7 = i.add %6, i64 1
  %8 = enum.len %3
  %9 = i.cmp le %7, %8
  cond_br %9, each.body, each.end
each.body:
  %11 = i.add %6, i64 1
  each.move $f1, false, %11
  %13 = load $f2 maybe_ref
  %14 = load $f1 ref
  %15 = binary add %13, %14
  store $f2 maybe_ref, %15
  barrier $f2 maybe_ref
  %18 = i.add %6, i64 1
  br each.test(%18)
each.end:
  each.leave $f1, false, %4
  %21 = block MAIN.block1 $f2
  %22 = call EVAL native %21, 2:w10
  ret %22
}

block MAIN.block1 internal params 1 {
  $f0 = frame 0 "K"
  $c0 = capture 0 "N"
entry:
  %0 = load $f0 maybe_ref
  %1 = load $c0 maybe_ref
  %2 = binary mul %0, %1
  ret %2
}

block MAIN.block2 internal params 1 {
  $f0 = frame 0 "K"
  $c0 = capture 0 "N"
entry:
  %0 = load $f0 maybe_ref
  %1 = load $c0 maybe_ref
  %2 = binary mul %0, %1
  ret %2
}
