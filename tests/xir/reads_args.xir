module READS_ARGS

function COUNT params 1 args {
  $f0 = frame 0 "A"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward COUNT.byref
  ret %2
body:
  %4 = load $f0
  %5 = call PCOUNT native
  %6 = binary add %5, %4
  ret %6
}

function VALUE params 1 args {
  $f0 = frame 0 shared "A"
entry:
  store $f0 maybe_ref, 1:w10
  barrier $f0 maybe_ref
  %2 = call PVALUE native 1:w10
  ret %2
}

function PLAIN params 1 {
  $f0 = frame 0 "A"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward PLAIN.byref
  ret %2
body:
  %4 = block PLAIN.block2
  ret %4
}

function COUNT.byref internal params 1 args {
  $f0 = frame 0 "A"
entry:
  %0 = call PCOUNT native
  %1 = load $f0 maybe_ref
  %2 = binary add %0, %1
  ret %2
}

function PLAIN.byref internal params 1 {
  $f0 = frame 0 "A"
entry:
  %0 = block PLAIN.block1
  ret %0
}

block PLAIN.block1 internal params 1 args {
  $f0 = frame 0 "X"
entry:
  %0 = call PCOUNT native
  ret %0
}

block PLAIN.block2 internal params 1 args {
  $f0 = frame 0 "X"
entry:
  %0 = call PCOUNT native
  ret %0
}
