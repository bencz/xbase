module CHOOSES_LIMITS

function LIMITS params 1 {
  $f0 = frame 0 "N"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward LIMITS.byref
  ret %2
body:
  %4 = load $f0 move
  %5 = call LEN native %4
  %6 = call MAX native %5, 4:w10
  %7 = binary div %6, 2:w10
  %8 = call INT native %7
  %9 = binary sub %8, 1:w10
  %10 = call MAX native %9, 0:w10
  %11 = subst.check guard 4 %10
  cond_br %11, body.subst, for.test(1:w10, 0:w10)
for.test(%13: item, %14: item):
  %15 = call LEN native %4
  %16 = subst.check %15
  cond_br %16, for.test.subst, for.test.3
for.body:
  %18 = binary sub %13, %10
  %19 = call MAX native 1:w10, %18
  %20 = subst.check %19
  cond_br %20, for.body.subst, for.test.2(%19, %14)
for.incr:
  %22 = binary add.one %13, 1:w0
  %23 = subst.check guard 4 %22
  cond_br %23, for.incr.subst, for.test(%22, %26)
for.test.2(%25: item, %26: item):
  %27 = call LEN native %4
  %28 = binary add %13, %10
  %29 = call MIN native %27, %28
  %30 = subst.check %29
  cond_br %30, for.test.2.subst, for.test.2
for.body.2:
  %32 = binary add.grow %26, %25
  %33 = binary add.one %25, 1:w0
  br for.test.2(%33, %32)
seq.exit:
  ret %14
for.test.2:
  %36 = for.test %25, %29, 1:w0
  cond_br %36, for.body.2, for.incr
for.test.3:
  %38 = for.test %13, %15, 1:w0
  cond_br %38, for.body, seq.exit
for.test.any(%40: item, %41: item, %42: item, %43: item):
  %44 = call LEN native %42
  br for.test.3.any(%40, %41, %42, %43, %44)
for.body.any:
  %46 = binary sub %72, %75
  %47 = call MAX native 1:w10, %46
  br for.test.2.any(%47, %73, %72, %74, %75)
for.incr.any:
  %49 = binary add.one %64, 1:w0
  br for.test.any(%49, %66, %67, %68)
for.test.2.any(%51: item, %52: item, %53: item, %54: item, %55: item):
  %56 = call LEN native %54
  %57 = binary add %53, %55
  %58 = call MIN native %56, %57
  br for.test.2.any.2(%53, %51, %52, %54, %55, %58)
for.body.2.any:
  %60 = binary add.grow %66, %65
  %61 = binary add.one %65, 1:w0
  br for.test.2.any(%61, %60, %64, %67, %68)
seq.exit.any:
  ret %73
for.test.2.any.2(%64: item, %65: item, %66: item, %67: item, %68: item, %69: item):
  %70 = for.test %65, %69, 1:w0
  cond_br %70, for.body.2.any, for.incr.any
for.test.3.any(%72: item, %73: item, %74: item, %75: item, %76: item):
  %77 = for.test %72, %76, 1:w0
  cond_br %77, for.body.any, seq.exit.any
for.test.2.subst:
  %79 = subst.value %29
  br for.test.2.any.2(%13, %25, %26, %4, %10, %79)
for.test.subst:
  %81 = subst.value %15
  br for.test.3.any(%13, %14, %4, %10, %81)
for.body.subst:
  %83 = subst.value %19
  br for.test.2.any(%83, %14, %13, %4, %10)
for.incr.subst:
  %85 = subst.value %22
  br for.test.any(%85, %26, %4, %10)
body.subst:
  %87 = subst.value %10
  br for.test.any(1:w10, 0:w10, %4, %87)
}

function LIMITS.byref internal params 1 {
  $f0 = frame 0 "N"
entry:
  %0 = load $f0 maybe_ref
  %1 = call LEN native %0
