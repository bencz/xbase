module ASSIGN_LOOP

function MAIN params 0 {
  $f0 = frame 0 "A"
  $f1 = frame 1 "X"
  $f2 = frame 2 "I"
entry:
  %0 = array 1:w10, 2:w10
  store $f0, %0
  store $f1, 0:w10
  store $f2, 10:w10
  br for.test
for.test:
  %5 = load $f2
  %6 = for.test %5, 1:w10, -2:w10
  cond_br %6, for.body, for.end
for.body:
  %8 = load $f1
  %9 = load $f2
  %10 = binary add %8, %9
  store $f1, %10
  br for.incr
for.incr:
  %13 = load $f2
  %14 = binary add %13, -2:w10
  store $f2, %14
  br for.test
for.end:
  %17 = load $f0
  %18 = index %17, 1:w10
  %19 = binary add %18, 1:w0
  index.set %17, 1:w10, %19
  %21 = load $f1
  %22 = binary gt %21, 2:w10
  %23 = truth %22
  cond_br %23, and.rhs, and.end(false)
and.rhs:
  %25 = load $f1
  %26 = binary lt %25, 100:w10
  %27 = truth %26
  br and.end(%27)
and.end(%29: bool):
  cond_br %29, iif.then, iif.else
iif.then:
  %31 = load $f0
  %32 = index %31, 1:w10
  br iif.end(%32)
iif.else:
  br iif.end("out")
iif.end(%35: item):
  ret %35
}
