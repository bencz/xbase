module ASSIGN_LOOP

function MAIN params 0 {
entry:
  %0 = array 1:w10, 2:w10
  br for.test(0:w10, 10:w10)
for.test(%2: item, %3: item):
  %4 = for.test %3, 1:w10, -2:w10
  cond_br %4, for.body, for.end
for.body:
  %6 = binary add %2, %3
  %7 = binary add %3, -2:w10
  br for.test(%6, %7)
for.end:
  %9 = index %0, 1:w10
  %10 = binary add.one %9, 1:w0
  index.set %0, 1:w10, %10
  %12 = binary gt %2, 2:w10
  %13 = truth %12
  cond_br %13, and.rhs, and.end(false)
and.rhs:
  %15 = binary lt %2, 100:w10
  %16 = truth %15
  br and.end(%16)
and.end(%18: bool):
  cond_br %18, iif.then, iif.end("out")
iif.then:
  %20 = index %0, 1:w10
  br iif.end(%20)
iif.end(%22: item):
  ret %22
}
