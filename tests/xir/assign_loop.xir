module ASSIGN_LOOP

function MAIN params 0 {
entry:
  %0 = array 1:w10, 2:w10
  br for.test(0:w10, 10:w10)
for.test(%2: item, %3: item):
  %4 = for.test %3, 1:w10, -2:w10
  cond_br %4, for.body, for.end
for.body:
  %6 = binary add.grow %2, %3
  %7 = subst.check guard 4 %6
  cond_br %7, for.body.subst, for.body.2
for.end:
  %9 = index %0, 1:w10
  %10 = binary add.one %9, 1:w0
  index.set %0, 1:w10, %10
  %12 = binary gt %2, 2:w10
  %13 = truth %12
  cond_br %13, and.rhs, and.end(false)
and.rhs:
  %15 = binary lt %2, 100:w10
  %16 = truth %15
  br and.end(%16)
and.end(%18: bool):
  cond_br %18, iif.then, iif.end("out")
iif.then:
  %20 = index %0, 1:w10
  br iif.end(%20)
iif.end(%22: item):
  ret %22
for.body.2:
  %24 = binary add %3, -2:w10
  br for.test(%6, %24)
for.body.any:
  %26 = binary add.grow %44, %45
  br for.body.2.any(%45, %26)
for.end.any:
  %28 = index %0, 1:w10
  %29 = binary add.one %28, 1:w0
  index.set %0, 1:w10, %29
  %31 = binary gt %44, 2:w10
  %32 = truth %31
  cond_br %32, and.rhs.any, and.end.any(false)
and.rhs.any:
  %34 = binary lt %44, 100:w10
  %35 = truth %34
  br and.end.any(%35)
and.end.any(%37: bool):
  cond_br %37, iif.then.any, iif.end.any("out")
iif.then.any:
  %39 = index %0, 1:w10
  br iif.end.any(%39)
iif.end.any(%41: item):
  ret %41
for.body.2.any(%43: item, %44: item):
  %45 = binary add %43, -2:w10
  %46 = for.test %45, 1:w10, -2:w10
  cond_br %46, for.body.any, for.end.any
for.body.subst:
  %48 = subst.value %6
  br for.body.2.any(%3, %48)
}
