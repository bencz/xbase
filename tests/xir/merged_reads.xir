module MERGED_READS

function SUMS params 1 {
  $f0 = frame 0 "N"
  $f2 = frame 2 "T"
  $f7 = frame 7 "C"
  table $f2: 1:w10, 2:w10, 3:w10
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward SUMS.byref
  ret %2
body:
  %4 = load $f0 move
  %5 = subst.check guard 12 %4
  cond_br %5, body.subst, body.3
for.test(%7: item, %8: item):
  %9 = for.test %7, %4, 1:w0
  cond_br %9, for.body, seq.exit
for.body:
  %11 = object.get 0 %53
  %12 = subst.check guard 12 %11
  cond_br %12, for.body.subst, for.body.3
seq.exit:
  ret %8
for.body.3:
  %15 = binary mul %11, %11
  %16 = object.get 1 %53
  %17 = binary mul %16, %11
  %18 = subst.check %17
  cond_br %18, for.body.3.subst, for.body.3
for.body.3:
  %20 = binary add %15, %17
  %21 = binary add.grow %8, %20
  %22 = binary mod %7, 3:w10
  %23 = binary add %22, 1:w10
  %24 = table.index $f2, %23
  %25 = subst.check guard 4 %24
  cond_br %25, for.body.3.subst.2, for.body.3.2
for.body.3.2:
  %27 = binary mul %24, %24
  %28 = binary add.grow %21, %27
  %29 = object.get 0 %53
  %30 = binary sub %27, %24
  %31 = object.get 0 %53
  %32 = subst.check guard 12 %31
  cond_br %32, for.body.3.2.subst.2, for.body.3.2.2
for.body.3.2.2:
  %34 = binary mul %31, %31
  %35 = binary add %30, %34
  %36 = binary add.grow %28, %35
  %37 = call VALTYPE native %29
  append $f7, %37
  inline.enter PT:BUMP %53
  %40 = object.get 0 %53
  %41 = binary add.grow %40, 10:w10
  %42 = subst.check %41
  cond_br %42, for.body.3.2.2.subst, for.body.3.2.2
for.body.3.2.2:
  %44 = object.set 0 %53, %41
  inline.leave
  %46 = binary add.grow %36, %41
  %47 = object.set 0 %53, %7
  %48 = binary add.grow %46, %7
  %49 = binary add.one %7, 1:w0
  %50 = subst.check guard 4 %49
  cond_br %50, for.body.3.2.2.subst.2, for.test(%49, %48)
body.3:
  inline.enter PT
  %53 = class.new 0
  inline.leave
  store $f7, ""
  br for.test(1:w10, 0:w10)
for.test.any(%57: item, %58: item, %59: item, %60: item):
  %61 = for.test %57, %59, 1:w0
  cond_br %61, for.body.any, seq.exit.any
for.body.any:
  %63 = object.get 0 %60
  br for.body.3.any(%57, %58, %59, %63, %60)
seq.exit.any:
  ret %58
for.body.3.any(%66: item, %67: item, %68: item, %69: item, %70: item):
  %71 = binary mul %69, %69
  %72 = object.get 1 %70
  %73 = object.get 0 %70
  %74 = binary mul %72, %73
  br for.body.3.any.2(%66, %67, %68, %71, %74, %70)
for.body.3.any.2(%76: item, %77: item, %78: item, %79: item, %80: item, %81: item):
  %82 = binary add %79, %80
  %83 = binary add.grow %77, %82
  %84 = binary mod %76, 3:w10
  %85 = binary add %84, 1:w10
  %86 = table.index $f2, %85
  br for.body.3.2.any(%76, %78, %83, %85, %86, %81)
for.body.3.2.any(%88: item, %89: item, %90: item, %91: item, %92: item, %93: item):
  %94 = binary mul %92, %92
  %95 = binary add.grow %90, %94
  %96 = object.get 0 %93
  %97 = table.index $f2, %91
  %98 = binary mul %97, %97
  %99 = binary sub %98, %97
  %100 = object.get 0 %93
  br for.body.3.2.2.any(%88, %89, %95, %96, %99, %100, %93)
for.body.3.2.2.any(%102: item, %103: item, %104: item, %105: item, %106: item, %107: item, %108: item):
  %109 = binary mul %107, %107
  %110 = binary add %106, %109
  %111 = binary add.grow %104, %110
  %112 = call VALTYPE native %105
  append $f7, %112
  inline.enter PT:BUMP %108
  %115 = object.get 0 %108
  %116 = binary add.grow %115, 10:w10
  br for.body.3.2.2.any.2(%102, %103, %111, %116, %108)
for.body.3.2.2.any.2(%118: item, %119: item, %120: item, %121: item, %122: item):
  %123 = object.set 0 %122, %121
  inline.leave
  %125 = binary add.grow %120, %121
  %126 = object.set 0 %122, %118
  %127 = binary add.grow %125, %118
  %128 = binary add.one %118, 1:w0
  br for.test.any(%128, %127, %119, %122)
for.body.subst:
  %130 = subst.value %11
  br for.body.3.any(%7, %8, %4, %130, %53)
for.body.3.subst:
  %132 = subst.value %17
  br for.body.3.any.2(%7, %8, %4, %15, %132, %53)
for.body.3.subst.2:
  %134 = subst.value %24
  br for.body.3.2.any(%7, %4, %21, %23, %134, %53)
for.body.3.2.subst.2:
  %136 = subst.value %31
  br for.body.3.2.2.any(%7, %4, %28, %29, %30, %136, %53)
for.body.3.2.2.subst:
  %138 = subst.value %41
  br for.body.3.2.2.any.2(%7, %4, %36, %138, %53)
for.body.3.2.2.subst.2:
  %140 = subst.value %49
  br for.test.any(%140, %48, %4, %53)
body.subst:
  %142 = subst.value %4
  inline.enter PT
  %144 = class.new 0
  inline.leave
  store $f7, ""
  br for.test.any(1:w10, 0:w10, %142, %144)
}

function PT:BUMP internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward PT:BUMP.byref
  ret %2
body:
  %4 = load $f0 move
  %5 = send X from 0 %4
  %6 = binary add.grow %5, 10:w10
  %7 = send _X from 0 %4, %6
  ret %7
}

function PT params 0 {
entry:
  %0 = class.new 0
  ret %0
}

function PT:(INIT) internal params 0 {
entry:
  %0 = array 3:w10, 4:w10
  ret %0
}

function SUMS.byref internal params 1 {
  $f0 = frame 0 "N"
  $f2 = frame 2 "T"
  $f7 = frame 7 "C"
  table $f2: 1:w10, 2:w10, 3:w10
entry:
  inline.enter PT
  %1 = class.new 0
  inline.leave
  store $f7, ""
  br for.test(1:w10, 0:w10)
for.test(%5: item, %6: item):
  %7 = load $f0 maybe_ref
  %8 = for.test %5, %7, 1:w0
  cond_br %8, for.body, seq.exit
for.body:
  %10 = object.get 0 %1
  %11 = subst.check guard 12 %10
  cond_br %11, for.body.subst, for.body.3
seq.exit:
  ret %6
for.body.3:
  %14 = binary mul %10, %10
  %15 = object.get 1 %1
  %16 = binary mul %15, %10
  %17 = subst.check %16
  cond_br %17, for.body.3.subst, for.body.3
for.body.3:
  %19 = binary add %14, %16
  %20 = binary add.grow %6, %19
  %21 = binary mod %5, 3:w10
  %22 = binary add %21, 1:w10
  %23 = table.index $f2, %22
  %24 = subst.check guard 4 %23
  cond_br %24, for.body.3.subst.2, for.body.3.2
for.body.3.2:
  %26 = binary mul %23, %23
  %27 = binary add.grow %20, %26
  %28 = object.get 0 %1
  %29 = binary sub %26, %23
  %30 = object.get 0 %1
  %31 = subst.check guard 12 %30
  cond_br %31, for.body.3.2.subst.2, for.body.3.2.2
for.body.3.2.2:
  %33 = binary mul %30, %30
  %34 = binary add %29, %33
  %35 = binary add.grow %27, %34
  %36 = call VALTYPE native %28
  append $f7, %36
  inline.enter PT:BUMP %1
  %39 = object.get 0 %1
  %40 = binary add.grow %39, 10:w10
  %41 = subst.check %40
  cond_br %41, for.body.3.2.2.subst, for.body.3.2.2
for.body.3.2.2:
  %43 = object.set 0 %1, %40
  inline.leave
  %45 = binary add.grow %35, %40
  %46 = object.set 0 %1, %5
  %47 = binary add.grow %45, %5
  %48 = binary add.one %5, 1:w0
  %49 = subst.check guard 4 %48
  cond_br %49, for.body.3.2.2.subst.2, for.test(%48, %47)
for.body.any:
  %51 = object.get 0 %113
  br for.body.3.any(%115, %114, %113, %51)
seq.exit.any:
  ret %114
for.body.3.any(%54: item, %55: item, %56: item, %57: item):
  %58 = binary mul %57, %57
  %59 = object.get 1 %56
  %60 = object.get 0 %56
  %61 = binary mul %59, %60
  br for.body.3.any.2(%54, %55, %56, %58, %61)
for.body.3.any.2(%63: item, %64: item, %65: item, %66: item, %67: item):
  %68 = binary add %66, %67
  %69 = binary add.grow %64, %68
  %70 = binary mod %63, 3:w10
  %71 = binary add %70, 1:w10
  %72 = table.index $f2, %71
  br for.body.3.2.any(%63, %65, %69, %71, %72)
for.body.3.2.any(%74: item, %75: item, %76: item, %77: item, %78: item):
  %79 = binary mul %78, %78
  %80 = binary add.grow %76, %79
  %81 = object.get 0 %75
  %82 = table.index $f2, %77
  %83 = binary mul %82, %82
  %84 = binary sub %83, %82
  %85 = object.get 0 %75
  br for.body.3.2.2.any(%74, %75, %80, %81, %84, %85)
for.body.3.2.2.any(%87: item, %88: item, %89: item, %90: item, %91: item, %92: item):
  %93 = binary mul %92, %92
  %94 = binary add %91, %93
  %95 = binary add.grow %89, %94
  %96 = call VALTYPE native %90
  append $f7, %96
  inline.enter PT:BUMP %88
  %99 = object.get 0 %88
  %100 = binary add.grow %99, 10:w10
  br for.body.3.2.2.any.2(%87, %88, %95, %100)
for.body.3.2.2.any.2(%102: item, %103: item, %104: item, %105: item):
  %106 = object.set 0 %103, %105
  inline.leave
  %108 = binary add.grow %104, %105
  %109 = object.set 0 %103, %102
  %110 = binary add.grow %108, %102
  %111 = binary add.one %102, 1:w0
  br for.body.3.2.2.2.any(%103, %110, %111)
for.body.3.2.2.2.any(%113: item, %114: item, %115: item):
  %116 = load $f0 maybe_ref
  %117 = for.test %115, %116, 1:w0
  cond_br %117, for.body.any, seq.exit.any
for.body.subst:
  %119 = subst.value %10
  br for.body.3.any(%5, %6, %1, %119)
for.body.3.subst:
  %121 = subst.value %16
  br for.body.3.any.2(%5, %6, %1, %14, %121)
for.body.3.subst.2:
  %123 = subst.value %23
  br for.body.3.2.any(%5, %1, %20, %22, %123)
for.body.3.2.subst.2:
  %125 = subst.value %30
  br for.body.3.2.2.any(%5, %1, %27, %28, %29, %125)
for.body.3.2.2.subst:
  %127 = subst.value %40
  br for.body.3.2.2.any.2(%5, %1, %35, %127)
for.body.3.2.2.subst.2:
  %129 = subst.value %48
  br for.body.3.2.2.2.any(%1, %47, %129)
}

function PT:BUMP.byref internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = load $f0 maybe_ref
  %1 = send X from 0 %0
  %2 = binary add.grow %1, 10:w10
  %3 = send _X from 0 %0, %2
  ret %3
}
