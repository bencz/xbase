module TYPES_RANGES

function SUM params 0 {
entry:
  br for.test(1:w10, 0:w10)
for.test(%1: item {int}, %2: item {int}):
  %3 = for.test %1, 1000:w10, 1:w0
  cond_br %3, for.body, seq.exit
for.body:
  %5 = binary mul %1, 3:w10 {int}
  %6 = binary add.grow %2, %5 {int}
  %7 = subst.check guard 4 %6
  cond_br %7, for.body.subst, for.body.2
seq.exit:
  ret %2
for.body.2:
  %10 = binary add.one %1, 1:w0 {int}
  br for.test(%10, %6)
for.body.any:
  %12 = binary mul %18, 3:w10 {int}
  %13 = binary add.grow %17, %12 {any}
  br for.body.2.any(%18, %13)
seq.exit.any:
  ret %17
for.body.2.any(%16: item {int}, %17: item {any}):
  %18 = binary add.one %16, 1:w0 {int}
  %19 = for.test %18, 1000:w10, 1:w0
  cond_br %19, for.body.any, seq.exit.any
for.body.subst:
  %21 = subst.value %6 {any}
  br for.body.2.any(%1, %21)
}

function DOWN params 0 {
entry:
  br for.test(100:w10, 0:w10)
for.test(%1: item {int}, %2: item {int}):
  %3 = for.test %1, -100:w10, -2:w10
  cond_br %3, for.body, seq.exit
for.body:
  %5 = binary sub %1, 1:w10 {int}
  %6 = binary mul %5, 1000:w10 {int}
  %7 = binary add.grow %2, %6 {int}
  %8 = subst.check guard 4 %7
  cond_br %8, for.body.subst, for.body.2
seq.exit:
  ret %2
for.body.2:
  %11 = binary add %1, -2:w10 {int}
  br for.test(%11, %7)
for.body.any:
  %13 = binary sub %20, 1:w10 {int}
  %14 = binary mul %13, 1000:w10 {int}
  %15 = binary add.grow %19, %14 {any}
  br for.body.2.any(%20, %15)
seq.exit.any:
  ret %19
for.body.2.any(%18: item {int}, %19: item {any}):
  %20 = binary add %18, -2:w10 {int}
  %21 = for.test %20, -100:w10, -2:w10
  cond_br %21, for.body.any, seq.exit.any
for.body.subst:
  %23 = subst.value %7 {any}
  br for.body.2.any(%1, %23)
}

function STEPPED params 0 {
entry:
  br for.test(1:w10, 0:w10)
for.test(%1: item {int}, %2: item {int}):
  %3 = for.test %1, 500:w10, 3:w10
  cond_br %3, for.body, seq.exit
for.body:
  %5 = binary mul %1, %1 {int}
  %6 = binary add.grow %2, %5 {int}
  %7 = subst.check guard 4 %6
  cond_br %7, for.body.subst, for.body.2
seq.exit:
  ret %2
for.body.2:
  %10 = binary add %1, 3:w10 {int}
  br for.test(%10, %6)
for.body.any:
  %12 = binary mul %18, %18 {int}
  %13 = binary add.grow %17, %12 {any}
  br for.body.2.any(%18, %13)
seq.exit.any:
  ret %17
for.body.2.any(%16: item {int}, %17: item {any}):
  %18 = binary add %16, 3:w10 {int}
  %19 = for.test %18, 500:w10, 3:w10
  cond_br %19, for.body.any, seq.exit.any
for.body.subst:
  %21 = subst.value %6 {any}
  br for.body.2.any(%1, %21)
}

function SQUARES params 0 {
entry:
  br while.cond(2:w10, 0:w10)
while.cond(%1: item {int}, %2: item {int}):
  %3 = binary mul %1, %1 {int}
  %4 = subst.check guard 4 %3
  cond_br %4, while.cond.subst, while.cond.2
for.test(%6: item {int}, %7: item {int}):
  %8 = for.test %6, 2000000:w10, %1
  cond_br %8, for.body, for.end
for.body:
  %10 = binary add.one %7, 1:w0 {int}
  %11 = subst.check guard 4 %10
  cond_br %11, for.body.subst, for.body.2
for.end:
  %13 = binary add.one %1, 1:w0 {int}
  %14 = subst.check guard 4 %13
  cond_br %14, for.end.subst, while.cond(%13, %7)
seq.exit:
  ret %2
for.body.2:
  %17 = binary add %6, %1 {int}
  %18 = subst.check guard 4 %17
  cond_br %18, for.body.2.subst, for.test(%17, %10)
while.cond.2:
  %20 = binary le %3, 2000000:w10 {logical}
  %21 = truth %20
  cond_br %21, for.test(%3, %2), seq.exit
while.cond.any(%23: item {any}, %24: item {any}):
  %25 = binary mul %23, %23 {any}
  br while.cond.2.any(%23, %24, %25)
for.test.any(%27: item {any}, %28: item {any}, %29: item {any}):
  %30 = for.test %27, 2000000:w10, %29
  cond_br %30, for.body.any, for.end.any
for.body.any:
  %32 = binary add.one %28, 1:w0 {any}
  br for.body.2.any(%29, %27, %32)
for.end.any:
  %34 = binary add.one %29, 1:w0 {any}
  br while.cond.any(%34, %28)
seq.exit.any:
  ret %43
for.body.2.any(%37: item {any}, %38: item {any}, %39: item {any}):
  %40 = binary add %38, %37 {any}
  br for.test.any(%40, %39, %37)
while.cond.2.any(%42: item {any}, %43: item {any}, %44: item {any}):
  %45 = binary le %44, 2000000:w10 {any}
  %46 = truth %45
  cond_br %46, for.test.any(%44, %43, %42), seq.exit.any
for.body.subst:
  %48 = subst.value %10 {any}
  br for.body.2.any(%1, %6, %48)
for.body.2.subst:
  %50 = subst.value %17 {any}
  br for.test.any(%50, %10, %1)
while.cond.subst:
  %52 = subst.value %3 {any}
  br while.cond.2.any(%1, %2, %52)
for.end.subst:
  %54 = subst.value %13 {any}
  br while.cond.any(%54, %7)
}

function BOUNDED params 0 {
entry:
  br for.test(-2:w10, 0:w10)
for.test(%1: item {int}, %2: item {int}):
  %3 = call VAL native "2" {int,double}
  %4 = subst.check %3
  cond_br %4, for.test.subst, for.test.2
for.body:
  %6 = binary mul %1, 9999999999:w11 {int}
  %7 = subst.check guard 4 %6
  cond_br %7, for.body.subst, for.body.2
endif(%9: item {int}):
  %10 = binary add.grow %2, %9 {int}
  %11 = subst.check guard 4 %10
  cond_br %11, endif.subst, endif.3
then:
  %13 = binary lt %27, 1000:w10 {logical}
  %14 = truth %13
  cond_br %14, then.2, else.2
else:
  %16 = binary mul %27, 1000000000000000:w17 {int}
  %17 = subst.check guard 4 %16
  cond_br %17, else.subst, endif(%16)
then.2:
  %19 = binary mul %27, 1000000000000000:w17 {int}
  br endif(%19)
else.2:
  %21 = binary mul %27, 1000000000000000:w17 {int}
  %22 = subst.check guard 4 %21
  cond_br %22, else.2.subst, endif(%21)
seq.exit:
  ret %2
for.test.2:
  %25 = for.test %1, %3, 1:w0
  cond_br %25, for.body, seq.exit
for.body.2:
  %27 = binary add %6, 5:w10 {int}
  %28 = subst.check guard 4 %27
  cond_br %28, for.body.2.subst, for.body.2
for.body.2:
  %30 = binary gt %27, -1000:w10 {logical}
  %31 = truth %30
  cond_br %31, then, else
endif.3:
  %33 = binary add.one %1, 1:w0 {int}
  %34 = subst.check guard 4 %33
  cond_br %34, endif.3.subst, for.test(%33, %10)
for.test.any(%36: item {any}, %37: item {any}):
  %38 = call VAL native "2" {any}
  br for.test.2.any(%36, %37, %38)
for.body.any:
  %40 = binary mul %57, 9999999999:w11 {any}
  br for.body.2.any(%57, %58, %40)
endif.any(%42: item {any}, %43: item {any}, %44: item {any}):
  %45 = binary add.grow %44, %42 {any}
  br endif.3.any(%43, %45)
then.any:
  %47 = binary lt %69, 1000:w10 {any}
  %48 = truth %47
  cond_br %48, then.2.any, else.2.any
else.any:
  %50 = binary mul %69, 1000000000000000:w17 {any}
  br endif.any(%50, %67, %68)
then.2.any:
  %52 = binary mul %69, 1000000000000000:w17 {any}
  br endif.any(%52, %67, %68)
else.2.any:
  %54 = binary mul %69, 1000000000000000:w17 {any}
  br endif.any(%54, %67, %68)
seq.exit.any:
  ret %58
for.test.2.any(%57: item {any}, %58: item {any}, %59: item {any}):
  %60 = for.test %57, %59, 1:w0
  cond_br %60, for.body.any, seq.exit.any
for.body.2.any(%62: item {any}, %63: item {any}, %64: item {any}):
  %65 = binary add %64, 5:w10 {any}
  br for.body.2.any.2(%62, %63, %65)
for.body.2.any.2(%67: item {any}, %68: item {any}, %69: item {any}):
  %70 = binary gt %69, -1000:w10 {any}
  %71 = truth %70
  cond_br %71, then.any, else.any
endif.3.any(%73: item {any}, %74: item {any}):
  %75 = binary add.one %73, 1:w0 {any}
  br for.test.any(%75, %74)
for.test.subst:
  %77 = subst.value %3 {any}
  br for.test.2.any(%1, %2, %77)
for.body.subst:
  %79 = subst.value %6 {any}
  br for.body.2.any(%1, %2, %79)
for.body.2.subst:
  %81 = subst.value %27 {any}
  br for.body.2.any.2(%1, %2, %81)
else.2.subst:
  %83 = subst.value %21 {any}
  br endif.any(%83, %1, %2)
else.subst:
  %85 = subst.value %16 {any}
  br endif.any(%85, %1, %2)
endif.subst:
  %87 = subst.value %10 {any}
  br endif.3.any(%1, %87)
endif.3.subst:
  %89 = subst.value %33 {any}
  br for.test.any(%89, %10)
}

function QUOTIENTS params 0 {
entry:
  br for.test(-1000:w10, 0:w10)
for.test(%1: item {int}, %2: item {int}):
  %3 = for.test %1, 1000:w10, 1:w0
  cond_br %3, for.body, seq.exit
for.body:
  %5 = binary div %1, 16:w10 {double}
  %6 = call INT native %5 {int}
  %7 = subst.check %6
  cond_br %7, for.body.subst, for.body.2
seq.exit:
  ret %2
for.body.2:
  %10 = binary mul %6, 7:w10 {int}
  %11 = binary add.grow %2, %10 {int}
  %12 = subst.check guard 4 %11
  cond_br %12, for.body.2.subst, for.body.2
for.body.2:
  %14 = binary add.one %1, 1:w0 {int}
  br for.test(%14, %11)
for.body.any:
  %16 = binary div %28, 16:w10 {double}
  %17 = call INT native %16 {int}
  br for.body.2.any(%28, %27, %17)
seq.exit.any:
  ret %27
for.body.2.any(%20: item {int}, %21: item {any}, %22: item {any}):
  %23 = binary mul %22, 7:w10 {any}
  %24 = binary add.grow %21, %23 {any}
  br for.body.2.any.2(%20, %24)
for.body.2.any.2(%26: item {int}, %27: item {any}):
  %28 = binary add.one %26, 1:w0 {int}
  %29 = for.test %28, 1000:w10, 1:w0
  cond_br %29, for.body.any, seq.exit.any
for.body.subst:
  %31 = subst.value %6 {any}
  br for.body.2.any(%1, %2, %31)
for.body.2.subst:
  %33 = subst.value %11 {any}
  br for.body.2.any.2(%1, %33)
}
