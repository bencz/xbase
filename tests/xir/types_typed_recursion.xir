module TYPES_TYPED_RECURSION

function MAIN params 1 {
  $f0 = frame 0 "K"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward MAIN.byref {any}
  ret %2
body:
  %4 = load $f0 {any}
  inline.enter ACK.typed3
  %6 = call ACK.typed3 2:w10, 2:w0 {int,double}
  %7 = call ACK.typed4 1:w0, %6 {int,double}
  inline.leave
  %9 = call ACK.typed1 %4, 1:w10 {int,double}
  %10 = binary add %7, %9 {int,double}
  ret %10
}

function MAIN.byref internal params 1 {
  $f0 = frame 0 "K"
entry:
  inline.enter ACK.typed3
  %1 = call ACK.typed3 2:w10, 2:w0 {int,double}
  %2 = call ACK.typed4 1:w0, %1 {int,double}
  inline.leave
  %4 = load $f0 maybe_ref {any}
  %5 = call ACK.typed1 %4, 1:w10 {int,double}
  %6 = binary add %2, %5 {int,double}
  ret %6
}

function ACK.typed1 internal params 2 {
  $f0 = frame 0 "M"
  $f1 = frame 1 "N"
entry:
  %0 = load $f0 {any}
  %1 = load $f1 {int}
  %2 = binary exacteq %0, 0:w10 {any}
  %3 = truth %2
  cond_br %3, then, else
endif:
  %5 = binary sub %0, 1:w10 {any}
  %6 = binary sub %1, 1:w10 {int,double}
  %7 = call ACK.typed2 %0, %6 {int,double}
  %8 = call ACK.typed2 %5, %7 {int,double}
  ret %8
then:
  %10 = binary add %1, 1:w10 {int,double}
  ret %10
else:
  %12 = binary exacteq %1, 0:w10 {logical}
  %13 = truth %12
  cond_br %13, then.2, endif
then.2:
  %15 = binary sub %0, 1:w10 {any}
  %16 = call ACK.typed1 %15, 1:w10 {int,double}
  ret %16
}

function ACK.typed2 internal params 2 {
  $f0 = frame 0 "M"
  $f1 = frame 1 "N"
entry:
  %0 = load $f0 {any}
  %1 = load $f1 {int,double}
  %2 = binary exacteq %0, 0:w10 {any}
  %3 = truth %2
  cond_br %3, then, else
endif:
  %5 = binary sub %0, 1:w10 {any}
  %6 = binary sub %1, 1:w10 {int,double}
  %7 = call ACK.typed2 %0, %6 {int,double}
  %8 = call ACK.typed2 %5, %7 {int,double}
  ret %8
then:
  %10 = binary add %1, 1:w10 {int,double}
  ret %10
else:
  %12 = binary exacteq %1, 0:w10 {logical}
  %13 = truth %12
  cond_br %13, then.2, endif
then.2:
  %15 = binary sub %0, 1:w10 {any}
  %16 = call ACK.typed1 %15, 1:w10 {int,double}
  ret %16
}

function ACK.typed3 internal params 2 {
  $f0 = frame 0 "M"
  $f1 = frame 1 "N"
entry:
  %0 = load $f0 {int}
  %1 = load $f1 {int}
  %2 = binary exacteq %0, 0:w10 {logical}
  %3 = truth %2
  cond_br %3, then, else
endif:
  %5 = binary sub %0, 1:w10 {int,double}
  %6 = binary sub %1, 1:w10 {int,double}
  %7 = call ACK.typed4 %0, %6 {int,double}
  %8 = call ACK.typed7 %5, %7 {int,double}
  ret %8
then:
  %10 = binary add %1, 1:w10 {int,double}
  ret %10
else:
  %12 = binary exacteq %1, 0:w10 {logical}
  %13 = truth %12
  cond_br %13, then.2, endif
then.2:
  %15 = binary sub %0, 1:w10 {int,double}
  %16 = call ACK.typed6 %15, 1:w10 {int,double}
  ret %16
}

function ACK.typed4 internal params 2 {
  $f0 = frame 0 "M"
  $f1 = frame 1 "N"
entry:
  %0 = load $f0 {int}
  %1 = load $f1 {int,double}
  %2 = binary exacteq %0, 0:w10 {logical}
  %3 = truth %2
  cond_br %3, then, else
endif:
  %5 = binary sub %0, 1:w10 {int,double}
  %6 = binary sub %1, 1:w10 {int,double}
  %7 = call ACK.typed4 %0, %6 {int,double}
  %8 = call ACK.typed7 %5, %7 {int,double}
  ret %8
then:
  %10 = binary add %1, 1:w10 {int,double}
  ret %10
else:
  %12 = binary exacteq %1, 0:w10 {logical}
  %13 = truth %12
  cond_br %13, then.2, endif
then.2:
  %15 = binary sub %0, 1:w10 {int,double}
  %16 = call ACK.typed6 %15, 1:w10 {int,double}
  ret %16
}

function ACK.typed6 internal params 2 {
  $f0 = frame 0 "M"
  $f1 = frame 1 "N"
entry:
  %0 = load $f0 {int,double}
  %1 = load $f1 {int}
  %2 = binary exacteq %0, 0:w10 {logical}
  %3 = truth %2
  cond_br %3, then, else
endif:
  %5 = binary sub %0, 1:w10 {int,double}
  %6 = binary sub %1, 1:w10 {int,double}
  %7 = call ACK.typed7 %0, %6 {int,double}
  %8 = call ACK.typed7 %5, %7 {int,double}
  ret %8
then:
  %10 = binary add %1, 1:w10 {int,double}
  ret %10
else:
  %12 = binary exacteq %1, 0:w10 {logical}
  %13 = truth %12
  cond_br %13, then.2, endif
then.2:
  %15 = binary sub %0, 1:w10 {int,double}
  %16 = call ACK.typed6 %15, 1:w10 {int,double}
  ret %16
}

function ACK.typed7 internal params 2 {
  $f0 = frame 0 "M"
  $f1 = frame 1 "N"
entry:
  %0 = load $f0 {int,double}
  %1 = load $f1 {int,double}
  %2 = binary exacteq %0, 0:w10 {logical}
  %3 = truth %2
  cond_br %3, then, else
endif:
  %5 = binary sub %0, 1:w10 {int,double}
  %6 = binary sub %1, 1:w10 {int,double}
  %7 = call ACK.typed7 %0, %6 {int,double}
  %8 = call ACK.typed7 %5, %7 {int,double}
  ret %8
then:
  %10 = binary add %1, 1:w10 {int,double}
  ret %10
else:
  %12 = binary exacteq %1, 0:w10 {logical}
  %13 = truth %12
  cond_br %13, then.2, endif
then.2:
  %15 = binary sub %0, 1:w10 {int,double}
  %16 = call ACK.typed6 %15, 1:w10 {int,double}
