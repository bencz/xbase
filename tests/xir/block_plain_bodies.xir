module BLOCK_PLAIN_BODIES
  $s0 = static 0 "S_A"

function MAIN params 0 {
entry:
  %0 = block MAIN.block1 cells v 1:w10
  %1 = block MAIN.block4
  %2 = block MAIN.block6 cells v 1:w10
  %3 = block MAIN.block7
  %4 = array %0, %1, %2, %3
  ret %4
}

block MAIN.block1 internal params 1 {
  $f0 = frame 0 "A"
  $c0 = capture 0 ""
entry:
  %0 = load $s0
  %1 = load $f0 maybe_ref
  %2 = call AADD native %0, %1
  %3 = block MAIN.block1.block2 $c0
  ret %3
}

block MAIN.block1.block2 internal params 1 {
  $f0 = frame 0 "B"
  $c0 = capture 0 ""
entry:
  %0 = load $s0
  %1 = load $f0 maybe_ref
  %2 = call AADD native %0, %1
  %3 = block MAIN.block1.block2.block3 $c0
  ret %3
}

block MAIN.block1.block2.block3 internal params 1 {
  $f0 = frame 0 "C"
  $c0 = capture 0 "N"
entry:
  %0 = load $f0 maybe_ref
  %1 = load $c0 maybe_ref
  %2 = binary add %0, %1
  ret %2
}

block MAIN.block1.block2.block3.plain internal params 1 {
  $f0 = frame 0 "C"
  $c0 = capture 0 "N"
entry:
  %0 = load $f0 move
  %1 = load $c0 maybe_ref
  %2 = binary add %0, %1
  ret %2
}

block MAIN.block1.block2.plain internal params 1 {
  $f0 = frame 0 "B"
  $c0 = capture 0 ""
entry:
  %0 = load $f0 move
  %1 = load $s0
  %2 = call AADD native %1, %0
  %3 = block MAIN.block1.block2.block3 $c0
  ret %3
}

block MAIN.block1.plain internal params 1 {
  $f0 = frame 0 "A"
  $c0 = capture 0 ""
entry:
  %0 = load $f0 move
  %1 = load $s0
  %2 = call AADD native %1, %0
  %3 = block MAIN.block1.block2 $c0
  ret %3
}

block MAIN.block4 internal params 1 {
  $f0 = frame 0 shared "P"
entry:
  %0 = block MAIN.block4.block5 $f0
  ret %0
}

block MAIN.block4.block5 internal params 0 {
  $c0 = capture 0 "P"
entry:
  %0 = load $c0 maybe_ref
  ret %0
}

block MAIN.block6 internal params 0 {
  $c0 = capture 0 "N"
entry:
  %0 = load $c0 maybe_ref
  ret %0
}

block MAIN.block7 internal params 1 args {
  $f0 = frame 0 "X"
entry:
  %0 = call PCOUNT native
  %1 = load $f0 maybe_ref
  %2 = binary add %0, %1
  ret %2
}

module_init module.init internal params 0 {
entry:
  %0 = array
  store $s0, %0
  ret
}
