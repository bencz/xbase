module TYPED_REGIONS

function REGIONS params 1 {
  $f0 = frame 0 "N"
  $f2 = frame 2 "S"
  $f3 = frame 3 "C"
  $f4 = frame 4 "N"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward REGIONS.byref
  ret %2
body:
  %4 = load $f0 move
  store $f4, %4
  store $f2, 0:w10
  store $f3, ""
  br seq.body
seq.body unwind seq.unwind:
  store $f3, "x"
  br seq.join(0:w10, "x", %4)
seq.unwind:
  %11 = load $f4
  %12 = load $f3
  %13 = load $f2
  %14 = seq.catch
  cond_br %14, seq.recover, seq.onward
seq.join(%16: item, %17: item, %18: item):
  %19 = subst.check guard 12 %18
  cond_br %19, seq.join.subst, for.test(1:w10, %16)
seq.recover:
  %21 = seq.value
  br seq.join(%13, %12, %11)
seq.onward:
  ret
for.test(%24: item, %25: item):
  %26 = for.test %24, %18, 1:w0
  cond_br %26, for.body, for.end(%17, %25)
for.body:
  %28 = binary mul %24, 3:w10
  %29 = subst.check guard 4 %28
  cond_br %29, for.body.subst, for.body.2
for.end(%31: item, %32: item):
  %33 = call STR native %32
  %34 = binary add %31, %33
  ret %34
for.body.2:
  %36 = binary add.grow %25, %28
  %37 = subst.check %36
  cond_br %37, for.body.2.subst, for.body.2
for.body.2:
  %39 = binary add.one %24, 1:w0
  %40 = subst.check guard 4 %39
  cond_br %40, for.body.2.subst.2, for.test(%39, %36)
for.test.any(%42: item, %43: item, %44: item, %45: item):
  %46 = for.test %42, %44, 1:w0
  cond_br %46, for.body.any, for.end(%45, %43)
for.body.any:
  %48 = binary mul %42, 3:w10
  br for.body.2.any(%44, %42, %43, %48, %45)
for.body.2.any(%50: item, %51: item, %52: item, %53: item, %54: item):
  %55 = binary add.grow %52, %53
  br for.body.2.any.2(%50, %51, %55, %54)
for.body.2.any.2(%57: item, %58: item, %59: item, %60: item):
  %61 = binary add.one %58, 1:w0
  br for.test.any(%61, %59, %57, %60)
for.body.subst:
  %63 = subst.value joined %28
  br for.body.2.any(%18, %24, %25, %63, %17)
for.body.2.subst:
  %65 = subst.value joined %36
  br for.body.2.any.2(%18, %24, %65, %17)
for.body.2.subst.2:
  %67 = subst.value joined %39
  br for.test.any(%67, %36, %18, %17)
seq.join.subst:
  %69 = subst.value joined %18
  br for.test.any(1:w10, %16, %69, %17)
}

function REGIONS.byref internal params 1 {
  $f0 = frame 0 "N"
  $f2 = frame 2 "S"
  $f3 = frame 3 "C"
entry:
  store $f2, 0:w10
  store $f3, ""
  br seq.body
seq.body unwind seq.unwind:
  store $f3, "x"
  br seq.join(0:w10, "x")
seq.unwind:
  %5 = load $f3
  %6 = load $f2
  %7 = seq.catch
  cond_br %7, seq.recover, seq.onward
seq.join(%9: item, %10: item):
  br for.test(1:w10, %9)
seq.recover:
  %12 = seq.value
  br seq.join(%6, %5)
seq.onward:
  ret
for.test(%15: item, %16: item):
  %17 = load $f0 maybe_ref
  %18 = for.test %15, %17, 1:w0
  cond_br %18, for.body, for.end(%16)
for.body:
  %20 = binary mul %15, 3:w10
  %21 = subst.check guard 4 %20
  cond_br %21, for.body.subst, for.body.2
for.end(%23: item):
  %24 = call STR native %23
  %25 = binary add %10, %24
  ret %25
for.body.2:
  %27 = binary add.grow %16, %20
  %28 = subst.check %27
  cond_br %28, for.body.2.subst, for.body.2
for.body.2:
  %30 = binary add.one %15, 1:w0
  %31 = subst.check guard 4 %30
  cond_br %31, for.body.2.subst.2, for.test(%30, %27)
for.test.any(%33: item, %34: item):
  %35 = load $f0 maybe_ref
  %36 = for.test %33, %35, 1:w0
  cond_br %36, for.body.any, for.end(%34)
for.body.any:
  %38 = binary mul %33, 3:w10
  br for.body.2.any(%33, %34, %38)
for.body.2.any(%40: item, %41: item, %42: item):
  %43 = binary add.grow %41, %42
  br for.body.2.any.2(%40, %43)
for.body.2.any.2(%45: item, %46: item):
  %47 = binary add.one %45, 1:w0
  br for.test.any(%47, %46)
for.body.subst:
  %49 = subst.value joined %20
  br for.body.2.any(%15, %16, %49)
for.body.2.subst:
  %51 = subst.value joined %27
  br for.body.2.any.2(%15, %51)
for.body.2.subst.2:
  %53 = subst.value joined %30
  br for.test.any(%53, %27)
}
