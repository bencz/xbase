module TYPED_REGIONS

function REGIONS params 1 {
  $f0 = frame 0 "N"
  $f1 = frame 1 "I"
  $f2 = frame 2 "S"
  $f3 = frame 3 "C"
  $f4 = frame 4 "N"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward REGIONS.byref
  ret %2
body:
  %4 = load $f0 move
  store $f4, %4
  store $f2, 0:w10
  store $f3, ""
  br seq.body
seq.body unwind seq.unwind:
  store $f3, "x"
  br seq.end
seq.unwind:
  %11 = seq.catch
  cond_br %11, seq.recover, seq.onward
seq.end:
  store $f1, 1:w10
  br for.test
seq.recover:
  %15 = seq.value
  br seq.end
seq.onward:
  ret
for.test:
  %18 = load $f4
  %19 = load $f1
  %20 = for.test %19, %18, 1:w0
  cond_br %20, for.body, for.end
for.body:
  %22 = load $f2
  %23 = load $f1
  %24 = binary mul %23, 3:w10
  %25 = subst.check %24
  cond_br %25, for.body.subst, for.body.2
for.end:
  %27 = load $f3
  %28 = load $f2
  %29 = call STR native %28
  %30 = binary add %27, %29
  ret %30
for.body.2:
  %32 = binary add.grow %22, %24
  store $f2, %32
  %34 = load $f1
  %35 = binary add.one %34, 1:w0
  store $f1, %35
  br for.test
for.body.any:
  %38 = load $f2
  %39 = load $f1
  %40 = binary mul %39, 3:w10
  br for.body.2.any(%38, %40)
for.body.2.any(%42: item, %43: item):
  %44 = binary add.grow %42, %43
  store $f2, %44
  %46 = load $f1
  %47 = binary add.one %46, 1:w0
  store $f1, %47
  %49 = load $f4
  %50 = load $f1
  %51 = for.test %50, %49, 1:w0
  cond_br %51, for.body.any, for.end
for.body.subst:
  %53 = subst.value joined %24
  br for.body.2.any(%22, %53)
}

function REGIONS.byref internal params 1 {
  $f0 = frame 0 "N"
  $f1 = frame 1 "I"
  $f2 = frame 2 "S"
  $f3 = frame 3 "C"
entry:
  store $f2, 0:w10
  store $f3, ""
  br seq.body
seq.body unwind seq.unwind:
  store $f3, "x"
  br seq.end
seq.unwind:
  %5 = seq.catch
  cond_br %5, seq.recover, seq.onward
seq.end:
  store $f1, 1:w10
  br for.test
seq.recover:
  %9 = seq.value
  br seq.end
seq.onward:
  ret
for.test:
  %12 = load $f0 maybe_ref
  %13 = load $f1
  %14 = for.test %13, %12, 1:w0
  cond_br %14, for.body, for.end
for.body:
  %16 = load $f2
  %17 = load $f1
  %18 = binary mul %17, 3:w10
  %19 = subst.check %18
  cond_br %19, for.body.subst, for.body.2
for.end:
  %21 = load $f3
  %22 = load $f2
  %23 = call STR native %22
  %24 = binary add %21, %23
  ret %24
for.body.2:
  %26 = binary add.grow %16, %18
  store $f2, %26
  %28 = load $f1
  %29 = binary add.one %28, 1:w0
  store $f1, %29
  br for.test
for.body.any:
  %32 = load $f2
  %33 = load $f1
  %34 = binary mul %33, 3:w10
  br for.body.2.any(%32, %34)
for.body.2.any(%36: item, %37: item):
  %38 = binary add.grow %36, %37
  store $f2, %38
  %40 = load $f1
  %41 = binary add.one %40, 1:w0
  store $f1, %41
  %43 = load $f0 maybe_ref
  %44 = load $f1
  %45 = for.test %44, %43, 1:w0
  cond_br %45, for.body.any, for.end
for.body.subst:
  %47 = subst.value joined %18
  br for.body.2.any(%16, %47)
}
