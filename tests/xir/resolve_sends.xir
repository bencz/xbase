module RESOLVE_SENDS

function MAIN params 1 {
  $f0 = frame 0 "X"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward MAIN.byref
  ret %2
body:
  %4 = load $f0 move
  inline.enter TPAIR
  %6 = class.new 1
  inline.leave
  %8 = send NEW %6
  %9 = array %8
  %10 = object.set 0 %8, 1:w10
  %11 = object.get 0 %8
  inline.enter TBASIS:DOUBLED %8
  %13 = object.get 3 %8
  %14 = binary mul %13, 2:w10
  inline.leave
  %16 = binary add %11, %14
  %17 = object.set 1 %8, %16
  inline.enter TPAIR:TOTAL %8
  %19 = object.get 0 %8
  %20 = object.get 1 %8
  %21 = binary add %19, %20
  %22 = object.get 3 %8
  %23 = binary add %21, %22
  %24 = binary gt %23, 100:w10
  %25 = truth %24
  cond_br %25, endif.inline(100:w10), endif.inline(%23)
body.2:
  %27 = send FIRST %56
  br body.2.2(%27)
body.2.2(%29: item):
  %30 = object.is 1 %4
  cond_br %30, body.2.2.resolved, body.2.2
body.2.resolved:
  %32 = object.get 0 %56
  br body.2.2(%32)
body.2.2:
  %34 = send FIRST %4
  br body.2.2.2(%34)
body.2.2.2(%36: item):
  %37 = call QOUT native %48, %51, %52, %53, %54, %55, %29, %36
  ret
body.2.2.resolved:
  %39 = object.get 0 %4
  br body.2.2.2(%39)
endif.inline(%41: item):
  inline.enter TBASIS:DOUBLED %8
  %43 = object.get 3 %8
  %44 = binary mul %43, 2:w10
  inline.leave
  %46 = binary add %41, %44
  %47 = object.get 3 %8
  %48 = binary sub %46, %47
  inline.leave
  %50 = send TBASIS %8
  %51 = send BASE %50
  %52 = send COUNT %8
  %53 = send _FIRST %8
  %54 = send NOTHING %8
  %55 = send SECRET %8
  %56 = index %9, 1:w10
  %57 = object.is 1 %56
  cond_br %57, body.2.resolved, body.2
}

function TPAIR:TOTAL internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward TPAIR:TOTAL.byref
  ret %2
body:
  %4 = load $f0 move
  %5 = send FIRST from 1 %4
  %6 = send LAST from 1 %4
  %7 = binary add %5, %6
  %8 = send BASE from 1 %4
  %9 = binary add %7, %8
  %10 = binary gt %9, 100:w10
  %11 = truth %10
  cond_br %11, endif(100:w10), endif(%9)
endif(%13: item):
  %14 = send DOUBLED from 1 %4
  %15 = binary add %13, %14
  %16 = send BASE from 1 %4
  %17 = binary sub %15, %16
  ret %17
}

function TBASIS:DOUBLED internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward TBASIS:DOUBLED.byref
  ret %2
body:
  %4 = load $f0 move
  %5 = send BASE from 0 %4
  %6 = binary mul %5, 2:w10
  ret %6
}

function TBASIS params 0 {
entry:
  %0 = class.new 0
  ret %0
}

function TBASIS:(INIT) internal params 0 {
entry:
  %0 = array 10:w10, 0:w10
  ret %0
}

function TPAIR params 0 {
entry:
  %0 = class.new 1
  ret %0
}

function TPAIR:(INIT) internal params 0 {
entry:
  %0 = array 0:w10, 0:w10, "s"
  ret %0
}

function MAIN.byref internal params 1 {
  $f0 = frame 0 "X"
entry:
  inline.enter TPAIR
  %1 = class.new 1
  inline.leave
  %3 = send NEW %1
  %4 = array %3
  %5 = object.set 0 %3, 1:w10
  %6 = object.get 0 %3
  inline.enter TBASIS:DOUBLED %3
  %8 = object.get 3 %3
  %9 = binary mul %8, 2:w10
  inline.leave
  %11 = binary add %6, %9
  %12 = object.set 1 %3, %11
  inline.enter TPAIR:TOTAL %3
  %14 = object.get 0 %3
  %15 = object.get 1 %3
  %16 = binary add %14, %15
  %17 = object.get 3 %3
  %18 = binary add %16, %17
  %19 = binary gt %18, 100:w10
  %20 = truth %19
  cond_br %20, endif.inline(100:w10), endif.inline(%18)
entry.2:
  %22 = send FIRST %52
  br entry.2.2(%22)
entry.2.2(%24: item):
  %25 = load $f0 maybe_ref
  %26 = object.is 1 %25
  cond_br %26, entry.2.2.resolved, entry.2.2
entry.2.resolved:
  %28 = object.get 0 %52
  br entry.2.2(%28)
entry.2.2:
  %30 = send FIRST %25
  br entry.2.2.2(%30)
entry.2.2.2(%32: item):
  %33 = call QOUT native %44, %47, %48, %49, %50, %51, %24, %32
  ret
entry.2.2.resolved:
  %35 = object.get 0 %25
  br entry.2.2.2(%35)
endif.inline(%37: item):
  inline.enter TBASIS:DOUBLED %3
  %39 = object.get 3 %3
  %40 = binary mul %39, 2:w10
  inline.leave
  %42 = binary add %37, %40
  %43 = object.get 3 %3
  %44 = binary sub %42, %43
  inline.leave
  %46 = send TBASIS %3
  %47 = send BASE %46
  %48 = send COUNT %3
  %49 = send _FIRST %3
  %50 = send NOTHING %3
  %51 = send SECRET %3
  %52 = index %4, 1:w10
  %53 = object.is 1 %52
  cond_br %53, entry.2.resolved, entry.2
}

function TPAIR:TOTAL.byref internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = load $f0 maybe_ref
  %1 = send FIRST from 1 %0
  %2 = load $f0 maybe_ref
  %3 = send LAST from 1 %2
  %4 = binary add %1, %3
  %5 = load $f0 maybe_ref
  %6 = send BASE from 1 %5
  %7 = binary add %4, %6
  %8 = binary gt %7, 100:w10
  %9 = truth %8
  cond_br %9, endif(100:w10), endif(%7)
endif(%11: item):
  %12 = load $f0 maybe_ref
  %13 = send DOUBLED from 1 %12
  %14 = binary add %11, %13
  %15 = load $f0 maybe_ref
  %16 = send BASE from 1 %15
  %17 = binary sub %14, %16
  ret %17
}

function TBASIS:DOUBLED.byref internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = load $f0 maybe_ref
  %1 = send BASE from 0 %0
  %2 = binary mul %1, 2:w10
  ret %2
}
