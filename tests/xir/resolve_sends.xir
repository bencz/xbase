module RESOLVE_SENDS

function MAIN params 1 {
  $f0 = frame 0 "X"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward MAIN.byref
  ret %2
body:
  %4 = load $f0 move
  inline.enter TPAIR
  %6 = class.new 1
  inline.leave
  %8 = array %6
  %9 = object.set 0 %6, 1:w10
  %10 = object.get 0 %6
  inline.enter TBASIS:DOUBLED %6
  %12 = object.get 3 %6
  %13 = binary mul %12, 2:w10
  inline.leave
  %15 = binary add %10, %13
  %16 = object.set 1 %6, %15
  inline.enter TPAIR:TOTAL %6
  %18 = object.get 0 %6
  %19 = object.get 1 %6
  %20 = binary add %18, %19
  %21 = object.get 3 %6
  %22 = binary add %20, %21
  %23 = binary gt %22, 100:w10
  %24 = truth %23
  cond_br %24, endif.inline(100:w10), endif.inline(%22)
body.2:
  %26 = send FIRST %56
  br body.2.2(%26)
body.2.2(%28: item):
  %29 = object.is 1 %4
  cond_br %29, body.2.2.resolved, body.2.2
body.2.resolved:
  %31 = object.get 0 %56
  br body.2.2(%31)
body.2.2:
  %33 = send FIRST %4
  br body.2.2.2(%33)
body.2.2.2(%35: item):
  %36 = call QOUT native %47, %50, %51, %52, %53, %54, %28, %35
  ret
body.2.2.resolved:
  %38 = object.get 0 %4
  br body.2.2.2(%38)
endif.inline(%40: item):
  inline.enter TBASIS:DOUBLED %6
  %42 = object.get 3 %6
  %43 = binary mul %42, 2:w10
  inline.leave
  %45 = binary add %40, %43
  %46 = object.get 3 %6
  %47 = binary sub %45, %46
  inline.leave
  %49 = send TBASIS %6
  %50 = send BASE %49
  %51 = send COUNT %6
  %52 = send _FIRST %6
  %53 = send NOTHING %6
  %54 = send SECRET %6
  %55 = call LEN native %8
  %56 = index %8, %55
  %57 = object.is 1 %56
  cond_br %57, body.2.resolved, body.2
}

function TPAIR:TOTAL internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward TPAIR:TOTAL.byref
  ret %2
body:
  %4 = load $f0 move
  %5 = send FIRST from 1 %4
  %6 = send LAST from 1 %4
  %7 = binary add %5, %6
  %8 = send BASE from 1 %4
  %9 = binary add %7, %8
  %10 = binary gt %9, 100:w10
  %11 = truth %10
  cond_br %11, endif(100:w10), endif(%9)
endif(%13: item):
  %14 = send DOUBLED from 1 %4
  %15 = binary add %13, %14
  %16 = send BASE from 1 %4
  %17 = binary sub %15, %16
  ret %17
}

function TBASIS:DOUBLED internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward TBASIS:DOUBLED.byref
  ret %2
body:
  %4 = load $f0 move
  %5 = send BASE from 0 %4
  %6 = binary mul %5, 2:w10
  ret %6
}

function TBASIS params 0 {
entry:
  %0 = class.new 0
  ret %0
}

function TBASIS:(INIT) internal params 0 {
entry:
  %0 = array 10:w10, 0:w10
  ret %0
}

function TPAIR params 0 {
entry:
  %0 = class.new 1
  ret %0
}

function TPAIR:(INIT) internal params 0 {
entry:
  %0 = array 0:w10, 0:w10, "s"
  ret %0
}

function MAIN.byref internal params 1 {
  $f0 = frame 0 "X"
entry:
  inline.enter TPAIR
  %1 = class.new 1
  inline.leave
  %3 = array %1
  %4 = object.set 0 %1, 1:w10
  %5 = object.get 0 %1
  inline.enter TBASIS:DOUBLED %1
  %7 = object.get 3 %1
  %8 = binary mul %7, 2:w10
  inline.leave
  %10 = binary add %5, %8
  %11 = object.set 1 %1, %10
  inline.enter TPAIR:TOTAL %1
  %13 = object.get 0 %1
  %14 = object.get 1 %1
  %15 = binary add %13, %14
  %16 = object.get 3 %1
  %17 = binary add %15, %16
  %18 = binary gt %17, 100:w10
  %19 = truth %18
  cond_br %19, endif.inline(100:w10), endif.inline(%17)
entry.2:
  %21 = send FIRST %52
  br entry.2.2(%21)
entry.2.2(%23: item):
  %24 = load $f0 maybe_ref
  %25 = object.is 1 %24
  cond_br %25, entry.2.2.resolved, entry.2.2
entry.2.resolved:
  %27 = object.get 0 %52
  br entry.2.2(%27)
entry.2.2:
  %29 = send FIRST %24
  br entry.2.2.2(%29)
entry.2.2.2(%31: item):
  %32 = call QOUT native %43, %46, %47, %48, %49, %50, %23, %31
  ret
entry.2.2.resolved:
  %34 = object.get 0 %24
  br entry.2.2.2(%34)
endif.inline(%36: item):
  inline.enter TBASIS:DOUBLED %1
  %38 = object.get 3 %1
  %39 = binary mul %38, 2:w10
  inline.leave
  %41 = binary add %36, %39
  %42 = object.get 3 %1
  %43 = binary sub %41, %42
  inline.leave
  %45 = send TBASIS %1
  %46 = send BASE %45
  %47 = send COUNT %1
  %48 = send _FIRST %1
  %49 = send NOTHING %1
  %50 = send SECRET %1
  %51 = call LEN native %3
  %52 = index %3, %51
  %53 = object.is 1 %52
  cond_br %53, entry.2.resolved, entry.2
}

function TPAIR:TOTAL.byref internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = load $f0 maybe_ref
  %1 = send FIRST from 1 %0
  %2 = load $f0 maybe_ref
  %3 = send LAST from 1 %2
  %4 = binary add %1, %3
  %5 = load $f0 maybe_ref
  %6 = send BASE from 1 %5
  %7 = binary add %4, %6
  %8 = binary gt %7, 100:w10
  %9 = truth %8
  cond_br %9, endif(100:w10), endif(%7)
endif(%11: item):
  %12 = load $f0 maybe_ref
  %13 = send DOUBLED from 1 %12
  %14 = binary add %11, %13
  %15 = load $f0 maybe_ref
  %16 = send BASE from 1 %15
  %17 = binary sub %14, %16
  ret %17
}

function TBASIS:DOUBLED.byref internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = load $f0 maybe_ref
  %1 = send BASE from 0 %0
  %2 = binary mul %1, 2:w10
  ret %2
}
