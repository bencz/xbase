module RESOLVE_SENDS

function MAIN params 1 {
  $f0 = frame 0 "X"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward MAIN.byref
  ret %2
body:
  %4 = load $f0 move
  inline.enter TPAIR
  %6 = class.new 1
  inline.leave
  %8 = array %6
  %9 = object.set 0 %6, 1:w10
  inline.enter TBASIS:DOUBLED %6
  %11 = object.get 3 %6
  %12 = binary mul %11, 2:w10
  inline.leave
  %14 = binary add 1:w10, %12
  %15 = object.set 1 %6, %14
  inline.enter TPAIR:TOTAL %6
  %17 = object.get 0 %6
  %18 = binary add %17, %14
  %19 = object.get 3 %6
  %20 = binary add %18, %19
  %21 = binary gt %20, 100:w10
  %22 = truth %21
  cond_br %22, endif.inline(100:w10), endif.inline(%20)
body.2:
  %24 = send FIRST %54
  br body.2.2(%24)
body.2.2(%26: item):
  %27 = object.is 1 %4
  cond_br %27, body.2.2.resolved, body.2.2
body.2.resolved:
  %29 = object.get 0 %54
  br body.2.2(%29)
body.2.2:
  %31 = send FIRST %4
  br body.2.2.2(%31)
body.2.2.2(%33: item):
  %34 = call QOUT native %45, %48, %49, %50, %51, %52, %26, %33
  ret
body.2.2.resolved:
  %36 = object.get 0 %4
  br body.2.2.2(%36)
endif.inline(%38: item):
  inline.enter TBASIS:DOUBLED %6
  %40 = object.get 3 %6
  %41 = binary mul %40, 2:w10
  inline.leave
  %43 = binary add %38, %41
  %44 = object.get 3 %6
  %45 = binary sub %43, %44
  inline.leave
  %47 = send TBASIS %6
  %48 = send BASE %47
  %49 = send COUNT %6
  %50 = send _FIRST %6
  %51 = send NOTHING %6
  %52 = send SECRET %6
  %53 = call LEN native %8
  %54 = index %8, %53
  %55 = object.is 1 %54
  cond_br %55, body.2.resolved, body.2
}

function TPAIR:TOTAL internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward TPAIR:TOTAL.byref
  ret %2
body:
  %4 = load $f0 move
  %5 = send FIRST from 1 %4
  %6 = send LAST from 1 %4
  %7 = binary add %5, %6
  %8 = send BASE from 1 %4
  %9 = binary add %7, %8
  %10 = binary gt %9, 100:w10
  %11 = truth %10
  cond_br %11, endif(100:w10), endif(%9)
endif(%13: item):
  %14 = send DOUBLED from 1 %4
  %15 = binary add %13, %14
  %16 = send BASE from 1 %4
  %17 = binary sub %15, %16
  ret %17
}

function TBASIS:DOUBLED internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward TBASIS:DOUBLED.byref
  ret %2
body:
  %4 = load $f0 move
  %5 = send BASE from 0 %4
  %6 = binary mul %5, 2:w10
  ret %6
}

function TBASIS params 0 {
entry:
  %0 = class.new 0
  ret %0
}

function TBASIS:(INIT) internal params 0 {
entry:
  %0 = array 10:w10, 0:w10
  ret %0
}

function TPAIR params 0 {
entry:
  %0 = class.new 1
  ret %0
}

function TPAIR:(INIT) internal params 0 {
entry:
  %0 = array 0:w10, 0:w10, "s"
  ret %0
}

function MAIN.byref internal params 1 {
  $f0 = frame 0 "X"
entry:
  inline.enter TPAIR
  %1 = class.new 1
  inline.leave
  %3 = array %1
  %4 = object.set 0 %1, 1:w10
  inline.enter TBASIS:DOUBLED %1
  %6 = object.get 3 %1
  %7 = binary mul %6, 2:w10
  inline.leave
  %9 = binary add 1:w10, %7
  %10 = object.set 1 %1, %9
  inline.enter TPAIR:TOTAL %1
  %12 = object.get 0 %1
  %13 = binary add %12, %9
  %14 = object.get 3 %1
  %15 = binary add %13, %14
  %16 = binary gt %15, 100:w10
  %17 = truth %16
  cond_br %17, endif.inline(100:w10), endif.inline(%15)
entry.2:
  %19 = send FIRST %50
  br entry.2.2(%19)
entry.2.2(%21: item):
  %22 = load $f0 maybe_ref
  %23 = object.is 1 %22
  cond_br %23, entry.2.2.resolved, entry.2.2
entry.2.resolved:
  %25 = object.get 0 %50
  br entry.2.2(%25)
entry.2.2:
  %27 = send FIRST %22
  br entry.2.2.2(%27)
entry.2.2.2(%29: item):
  %30 = call QOUT native %41, %44, %45, %46, %47, %48, %21, %29
  ret
entry.2.2.resolved:
  %32 = object.get 0 %22
  br entry.2.2.2(%32)
endif.inline(%34: item):
  inline.enter TBASIS:DOUBLED %1
  %36 = object.get 3 %1
  %37 = binary mul %36, 2:w10
  inline.leave
  %39 = binary add %34, %37
  %40 = object.get 3 %1
  %41 = binary sub %39, %40
  inline.leave
  %43 = send TBASIS %1
  %44 = send BASE %43
  %45 = send COUNT %1
  %46 = send _FIRST %1
  %47 = send NOTHING %1
  %48 = send SECRET %1
  %49 = call LEN native %3
  %50 = index %3, %49
  %51 = object.is 1 %50
  cond_br %51, entry.2.resolved, entry.2
}

function TPAIR:TOTAL.byref internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = load $f0 maybe_ref
  %1 = send FIRST from 1 %0
  %2 = load $f0 maybe_ref
  %3 = send LAST from 1 %2
  %4 = binary add %1, %3
  %5 = load $f0 maybe_ref
  %6 = send BASE from 1 %5
  %7 = binary add %4, %6
  %8 = binary gt %7, 100:w10
  %9 = truth %8
  cond_br %9, endif(100:w10), endif(%7)
endif(%11: item):
  %12 = load $f0 maybe_ref
  %13 = send DOUBLED from 1 %12
  %14 = binary add %11, %13
  %15 = load $f0 maybe_ref
  %16 = send BASE from 1 %15
  %17 = binary sub %14, %16
  ret %17
}

function TBASIS:DOUBLED.byref internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = load $f0 maybe_ref
  %1 = send BASE from 0 %0
  %2 = binary mul %1, 2:w10
  ret %2
}
