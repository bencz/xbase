module AEVAL_INLINE

function MAIN params 0 {
entry:
  %0 = array 1:w10, 2:w10, 3:w10
  inline.enter AEVAL %0
  %2 = call LEN native %0
  %3 = call __RANGESTART native %2, nil
  %4 = subst.check guard 12 %3
  cond_br %4, entry.subst, entry.3
entry.2(%6: item):
  ret %6
endif.3.inline:
  %8 = call LEN native %0
  %9 = binary sub %8, %3
  %10 = binary add %9, 1:w10
  %11 = call __RANGECOUNT native %10, nil
  %12 = binary add %3, %11
  %13 = binary sub %12, 1:w10
  %14 = subst.check guard 12 %13
  cond_br %14, endif.3.inline.subst, for.test.inline(%3, 0:w10)
seq.exit.3.inline:
  inline.leave
  br entry.2(0:w10)
for.test.inline(%18: item, %19: item):
  %20 = for.test %18, %13, 1:w0
  cond_br %20, for.body.inline, seq.exit.5.inline
for.body.inline:
  %22 = call LEN native %0
  %23 = binary gt %18, %22
  %24 = truth %23
  cond_br %24, seq.exit.5.inline, endif.4.inline
endif.4.inline:
  %26 = index %0, %18
  inline.enter MAIN.block1 %26, %18
  %28 = binary add.grow %19, %26
  %29 = subst.check %28
  cond_br %29, endif.4.inline.subst, endif.4.inline.3
seq.exit.5.inline:
  inline.leave
  br entry.2(%19)
endif.4.inline.3:
  inline.leave
  %34 = binary add.one %18, 1:w0
  %35 = subst.check %34
  cond_br %35, endif.4.inline.3.subst, for.test.inline(%34, %28)
entry.3:
  %37 = binary exacteq %3, 0:w10
  %38 = truth %37
  cond_br %38, seq.exit.3.inline, endif.3.inline
entry.2.any(%40: item):
  ret %40
endif.3.inline.any:
  %42 = call LEN native %0
  %43 = binary sub %42, %78
  %44 = binary add %43, 1:w10
  %45 = call __RANGECOUNT native %44, nil
  %46 = binary add %78, %45
  %47 = binary sub %46, 1:w10
  br for.test.inline.any(%78, 0:w10, %0, %47)
seq.exit.3.inline.any:
  inline.leave
  br entry.2.any(0:w10)
for.test.inline.any(%51: item, %52: item, %53: item, %54: item):
  %55 = for.test %51, %54, 1:w0
  cond_br %55, for.body.inline.any, seq.exit.5.inline.any
for.body.inline.any:
  %57 = call LEN native %53
  %58 = binary gt %51, %57
  %59 = truth %58
  cond_br %59, seq.exit.5.inline.any, endif.4.inline.any
endif.4.inline.any:
  %61 = index %53, %51
  inline.enter MAIN.block1 %61, %51
  %63 = binary add.grow %52, %61
  br endif.4.inline.3.any(%51, %53, %54, %63)
seq.exit.5.inline.any:
  inline.leave
  br entry.2.any(%52)
endif.4.inline.3.any(%67: item, %68: item, %69: item, %70: item):
  inline.leave
  %72 = binary add.one %67, 1:w0
  br for.test.inline.any(%72, %70, %68, %69)
endif.4.inline.subst:
  %74 = subst.value %28
  br endif.4.inline.3.any(%18, %0, %13, %74)
endif.4.inline.3.subst:
  %76 = subst.value %34
  br for.test.inline.any(%76, %28, %0, %13)
entry.subst:
  %78 = subst.value %3
  %79 = binary exacteq %78, 0:w10
  %80 = truth %79
  cond_br %80, seq.exit.3.inline.any, endif.3.inline.any
endif.3.inline.subst:
  %82 = subst.value %13
  br for.test.inline.any(%3, 0:w10, %0, %82)
}

block MAIN.block1 internal params 1 {
  $f0 = frame 0 "X"
  $c0 = capture 0 "N"
entry:
  %0 = load $c0 maybe_ref
  %1 = load $f0 maybe_ref
  %2 = binary add.grow %0, %1
  store $c0 maybe_ref, %2
  barrier $c0 maybe_ref
  ret %2
}
