module AEVAL_INLINE

function MAIN params 0 {
entry:
  %0 = array 1:w10, 2:w10, 3:w10
  inline.enter AEVAL
  %2 = call LEN native %0
  %3 = call __RANGESTART native %2, nil
  %4 = subst.check guard 12 %3
  cond_br %4, entry.subst, entry.3
entry.2(%6: item):
  ret %6
endif.3.inline:
  %8 = call LEN native %0
  %9 = binary sub %8, %3
  %10 = binary add %9, 1:w10
  %11 = call __RANGECOUNT native %10, nil
  %12 = binary add %3, %11
  %13 = binary sub %12, 1:w10
  %14 = subst.check guard 12 %13
  cond_br %14, endif.3.inline.subst, for.test.inline(%3, 0:w10)
seq.exit.3.inline:
  inline.leave
  br entry.2(0:w10)
for.test.inline(%18: item, %19: item):
  %20 = for.test %18, %13, 1:w0
  cond_br %20, for.body.inline, seq.exit.5.inline
for.body.inline:
  %22 = call LEN native %0
  %23 = subst.check %22
  cond_br %23, for.body.inline.subst, for.body.inline.2
endif.4.inline:
  %25 = index %0, %18
  inline.enter MAIN.block1
  %27 = binary add %19, %25
  %28 = subst.check %27
  cond_br %28, endif.4.inline.subst, endif.4.inline.3
seq.exit.5.inline:
  inline.leave
  br entry.2(%19)
for.body.inline.2:
  %32 = binary gt %18, %22
  %33 = truth %32
  cond_br %33, seq.exit.5.inline, endif.4.inline
endif.4.inline.3:
  inline.leave
  %36 = binary add.one %18, 1:w0
  %37 = subst.check %36
  cond_br %37, endif.4.inline.3.subst, for.test.inline(%36, %27)
entry.3:
  %39 = binary exacteq %3, 0:w10
  %40 = truth %39
  cond_br %40, seq.exit.3.inline, endif.3.inline
entry.2.any(%42: item):
  ret %42
endif.3.inline.any:
  %44 = call LEN native %0
  %45 = binary sub %44, %89
  %46 = binary add %45, 1:w10
  %47 = call __RANGECOUNT native %46, nil
  %48 = binary add %89, %47
  %49 = binary sub %48, 1:w10
  br for.test.inline.any(%89, 0:w10, %0, %49)
seq.exit.3.inline.any:
  inline.leave
  br entry.2.any(0:w10)
for.test.inline.any(%53: item, %54: item, %55: item, %56: item):
  %57 = for.test %53, %56, 1:w0
  cond_br %57, for.body.inline.any, seq.exit.5.inline.any(%54)
for.body.inline.any:
  %59 = call LEN native %55
  br for.body.inline.2.any(%53, %54, %55, %56, %59)
endif.4.inline.any:
  %61 = index %70, %68
  inline.enter MAIN.block1
  %63 = binary add %69, %61
  br endif.4.inline.3.any(%68, %70, %71, %63)
seq.exit.5.inline.any(%65: item):
  inline.leave
  br entry.2.any(%65)
for.body.inline.2.any(%68: item, %69: item, %70: item, %71: item, %72: item):
  %73 = binary gt %68, %72
  %74 = truth %73
  cond_br %74, seq.exit.5.inline.any(%69), endif.4.inline.any
endif.4.inline.3.any(%76: item, %77: item, %78: item, %79: item):
  inline.leave
  %81 = binary add.one %76, 1:w0
  br for.test.inline.any(%81, %79, %77, %78)
for.body.inline.subst:
  %83 = subst.value %22
  br for.body.inline.2.any(%18, %19, %0, %13, %83)
endif.4.inline.subst:
  %85 = subst.value %27
  br endif.4.inline.3.any(%18, %0, %13, %85)
endif.4.inline.3.subst:
  %87 = subst.value %36
  br for.test.inline.any(%87, %27, %0, %13)
entry.subst:
  %89 = subst.value %3
  %90 = binary exacteq %89, 0:w10
  %91 = truth %90
  cond_br %91, seq.exit.3.inline.any, endif.3.inline.any
endif.3.inline.subst:
  %93 = subst.value %13
  br for.test.inline.any(%3, 0:w10, %0, %93)
}

block MAIN.block1 internal params 1 {
  $f0 = frame 0 "X"
  $c0 = capture 0 "N"
entry:
  %0 = load $c0 maybe_ref
  %1 = load $f0 maybe_ref
  %2 = binary add %0, %1
  store $c0 maybe_ref, %2
  barrier $c0 maybe_ref
  ret %2
}
