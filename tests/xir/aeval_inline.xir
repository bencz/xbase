module AEVAL_INLINE

function MAIN params 0 {
entry:
  %0 = array 1:w10, 2:w10, 3:w10
  inline.enter AEVAL %0
  %2 = call LEN native %0
  %3 = call __RANGESTART native %2, nil
  %4 = subst.check guard 12 %3
  cond_br %4, entry.subst, entry.3
entry.2(%6: item):
  ret %6
endif.3.inline:
  %8 = call LEN native %0
  %9 = binary sub %8, %3
  %10 = binary add %9, 1:w10
  %11 = call __RANGECOUNT native %10, nil
  %12 = binary add %3, %11
  %13 = binary sub %12, 1:w10
  %14 = subst.check guard 12 %13
  cond_br %14, endif.3.inline.subst, for.test.inline(%3, 0:w10)
seq.exit.3.inline:
  inline.leave
  br entry.2(0:w10)
for.test.inline(%18: item, %19: item):
  %20 = for.test %18, %13, 1:w0
  cond_br %20, for.body.inline, seq.exit.5.inline
for.body.inline:
  %22 = call LEN native %0
  %23 = binary gt %18, %22
  %24 = truth %23
  cond_br %24, seq.exit.5.inline, endif.4.inline
endif.4.inline:
  %26 = index %0, %18
  inline.enter MAIN.block1 %26, %18
  %28 = binary add.grow %19, %26
  %29 = subst.check %28
  cond_br %29, endif.4.inline.subst, endif.4.inline.3
seq.exit.5.inline:
  inline.leave
  br entry.2(%19)
endif.4.inline.3:
  inline.leave
  %34 = binary add.one %18, 1:w0
  br for.test.inline(%34, %28)
entry.3:
  %36 = binary exacteq %3, 0:w10
  %37 = truth %36
  cond_br %37, seq.exit.3.inline, endif.3.inline
entry.2.any(%39: item):
  ret %39
endif.3.inline.any:
  %41 = call LEN native %0
  %42 = binary sub %41, %75
  %43 = binary add %42, 1:w10
  %44 = call __RANGECOUNT native %43, nil
  %45 = binary add %75, %44
  %46 = binary sub %45, 1:w10
  br for.test.inline.any(%75, 0:w10, %0, %46)
seq.exit.3.inline.any:
  inline.leave
  br entry.2.any(0:w10)
for.test.inline.any(%50: item, %51: item, %52: item, %53: item):
  %54 = for.test %50, %53, 1:w0
  cond_br %54, for.body.inline.any, seq.exit.5.inline.any
for.body.inline.any:
  %56 = call LEN native %52
  %57 = binary gt %50, %56
  %58 = truth %57
  cond_br %58, seq.exit.5.inline.any, endif.4.inline.any
endif.4.inline.any:
  %60 = index %52, %50
  inline.enter MAIN.block1 %60, %50
  %62 = binary add.grow %51, %60
  br endif.4.inline.3.any(%50, %52, %53, %62)
seq.exit.5.inline.any:
  inline.leave
  br entry.2.any(%51)
endif.4.inline.3.any(%66: item, %67: item, %68: item, %69: item):
  inline.leave
  %71 = binary add.one %66, 1:w0
  br for.test.inline.any(%71, %69, %67, %68)
endif.4.inline.subst:
  %73 = subst.value %28
  br endif.4.inline.3.any(%18, %0, %13, %73)
entry.subst:
  %75 = subst.value %3
  %76 = binary exacteq %75, 0:w10
  %77 = truth %76
  cond_br %77, seq.exit.3.inline.any, endif.3.inline.any
endif.3.inline.subst:
  %79 = subst.value %13
  br for.test.inline.any(%3, 0:w10, %0, %79)
}

block MAIN.block1 internal params 1 {
  $f0 = frame 0 "X"
  $c0 = capture 0 "N"
entry:
  %0 = load $c0 maybe_ref
  %1 = load $f0 maybe_ref
  %2 = binary add.grow %0, %1
  store $c0 maybe_ref, %2
  barrier $c0 maybe_ref
  ret %2
}
