module TYPED_CONTINUATIONS

function SUM params 1 {
  $f0 = frame 0 "A"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward SUM.byref
  ret %2
body:
  %4 = load $f0
  br for.test(1:w10, 0:w10)
for.test(%6: item, %7: item):
  %8 = call LEN native %4
  %9 = subst.check %8
  cond_br %9, for.test.subst, for.test.2
for.body:
  %11 = index %4, %6
  %12 = binary mul %11, 2:w10
  %13 = subst.check %12
  cond_br %13, for.body.subst, for.body.2
seq.exit:
  ret %7
for.test.2:
  %16 = for.test %6, %8, 1:w0
  cond_br %16, for.body, seq.exit
for.body.2:
  %18 = binary add %7, %12
  %19 = binary add.one %6, 1:w0
  %20 = subst.check guard 4 %19
  cond_br %20, for.body.2.subst, for.test(%19, %18)
for.body.any:
  %22 = index %28, %26
  %23 = binary mul %22, 2:w10
  br for.body.2.any(%26, %27, %28, %23)
seq.exit.any:
  ret %27
for.test.2.any(%26: item, %27: item, %28: item, %29: item):
  %30 = for.test %26, %29, 1:w0
  cond_br %30, for.body.any, seq.exit.any
for.body.2.any(%32: item, %33: item, %34: item, %35: item):
  %36 = binary add %33, %35
  %37 = binary add.one %32, 1:w0
  br for.body.2.any.2(%34, %36, %37)
for.body.2.any.2(%39: item, %40: item, %41: item):
  %42 = call LEN native %39
  br for.test.2.any(%41, %40, %39, %42)
for.test.subst:
  %44 = subst.value %8
  br for.test.2.any(%6, %7, %4, %44)
for.body.subst:
  %46 = subst.value %12
  br for.body.2.any(%6, %7, %4, %46)
for.body.2.subst:
  %48 = subst.value %19
  br for.body.2.any.2(%4, %18, %48)
}

function SUM.byref internal params 1 {
  $f0 = frame 0 "A"
entry:
  br for.test(1:w10, 0:w10)
for.test(%1: item, %2: item):
  %3 = load $f0 maybe_ref
  %4 = call LEN native %3
  %5 = subst.check %4
  cond_br %5, for.test.subst, for.test.2
for.body:
  %7 = load $f0 maybe_ref
  %8 = index %7, %1
  %9 = binary mul %8, 2:w10
  %10 = subst.check %9
  cond_br %10, for.body.subst, for.body.2
seq.exit:
  ret %2
for.test.2:
  %13 = for.test %1, %4, 1:w0
  cond_br %13, for.body, seq.exit
for.body.2:
  %15 = binary add %2, %9
  %16 = binary add.one %1, 1:w0
  %17 = subst.check guard 4 %16
  cond_br %17, for.body.2.subst, for.test(%16, %15)
for.test.any(%19: item, %20: item):
  %21 = load $f0 maybe_ref
  %22 = call LEN native %21
  br for.test.2.any(%19, %20, %22)
for.body.any:
  %24 = load $f0 maybe_ref
  %25 = index %24, %29
  %26 = binary mul %25, 2:w10
  br for.body.2.any(%29, %30, %26)
seq.exit.any:
  ret %30
for.test.2.any(%29: item, %30: item, %31: item):
  %32 = for.test %29, %31, 1:w0
  cond_br %32, for.body.any, seq.exit.any
for.body.2.any(%34: item, %35: item, %36: item):
  %37 = binary add %35, %36
  %38 = binary add.one %34, 1:w0
  br for.test.any(%38, %37)
for.test.subst:
  %40 = subst.value %4
  br for.test.2.any(%1, %2, %40)
for.body.subst:
  %42 = subst.value %9
  br for.body.2.any(%1, %2, %42)
for.body.2.subst:
  %44 = subst.value %16
  br for.test.any(%44, %15)
}
