module TYPED_CONTINUATIONS

function SUM params 1 {
  $f0 = frame 0 "A"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward SUM.byref
  ret %2
body:
  %4 = load $f0
  br for.test(1:w10, 0:w10)
for.test(%6: item, %7: item):
  %8 = call LEN native %4
  %9 = subst.check %8
  cond_br %9, for.test.subst, for.test.2
for.body:
  %11 = index %4, %6
  %12 = binary mul %11, 2:w10
  %13 = subst.check %12
  cond_br %13, for.body.subst, for.body.2
seq.exit:
  ret %7
for.test.2:
  %16 = for.test %6, %8, 1:w0
  cond_br %16, for.body, seq.exit
for.body.2:
  %18 = binary add %7, %12
  %19 = binary add.one %6, 1:w0
  br for.test(%19, %18)
for.body.any:
  %21 = index %27, %25
  %22 = binary mul %21, 2:w10
  br for.body.2.any(%25, %26, %27, %22)
seq.exit.any:
  ret %26
for.test.2.any(%25: item, %26: item, %27: item, %28: item):
  %29 = for.test %25, %28, 1:w0
  cond_br %29, for.body.any, seq.exit.any
for.body.2.any(%31: item, %32: item, %33: item, %34: item):
  %35 = binary add %32, %34
  %36 = binary add.one %31, 1:w0
  %37 = call LEN native %33
  br for.test.2.any(%36, %35, %33, %37)
for.test.subst:
  %39 = subst.value %8
  br for.test.2.any(%6, %7, %4, %39)
for.body.subst:
  %41 = subst.value %12
  br for.body.2.any(%6, %7, %4, %41)
}

function SUM.byref internal params 1 {
  $f0 = frame 0 "A"
entry:
  br for.test(1:w10, 0:w10)
for.test(%1: item, %2: item):
  %3 = load $f0 maybe_ref
  %4 = call LEN native %3
  %5 = subst.check %4
  cond_br %5, for.test.subst, for.test.2
for.body:
  %7 = load $f0 maybe_ref
  %8 = index %7, %1
  %9 = binary mul %8, 2:w10
  %10 = subst.check %9
  cond_br %10, for.body.subst, for.body.2
seq.exit:
  ret %2
for.test.2:
  %13 = for.test %1, %4, 1:w0
  cond_br %13, for.body, seq.exit
for.body.2:
  %15 = binary add %2, %9
  %16 = binary add.one %1, 1:w0
  br for.test(%16, %15)
for.body.any:
  %18 = load $f0 maybe_ref
  %19 = index %18, %23
  %20 = binary mul %19, 2:w10
  br for.body.2.any(%23, %24, %20)
seq.exit.any:
  ret %24
for.test.2.any(%23: item, %24: item, %25: item):
  %26 = for.test %23, %25, 1:w0
  cond_br %26, for.body.any, seq.exit.any
for.body.2.any(%28: item, %29: item, %30: item):
  %31 = binary add %29, %30
  %32 = binary add.one %28, 1:w0
  %33 = load $f0 maybe_ref
  %34 = call LEN native %33
  br for.test.2.any(%32, %31, %34)
for.test.subst:
  %36 = subst.value %4
  br for.test.2.any(%1, %2, %36)
for.body.subst:
  %38 = subst.value %9
  br for.body.2.any(%1, %2, %38)
}
