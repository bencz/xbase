module TYPED_CONTINUATIONS

function SUM params 1 {
  $f0 = frame 0 "A"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward SUM.byref
  ret %2
body:
  %4 = load $f0
  br for.test(1:w10, 0:w10)
for.test(%6: item, %7: item):
  %8 = call LEN native %4
  %9 = for.test %6, %8, 1:w0
  cond_br %9, for.body, seq.exit
for.body:
  %11 = index %4, %6
  %12 = binary mul %11, 2:w10
  %13 = subst.check %12
  cond_br %13, for.body.subst, for.body.2
seq.exit:
  ret %7
for.body.2:
  %16 = binary add %7, %12
  %17 = binary add.one %6, 1:w0
  br for.test(%17, %16)
for.body.any:
  %19 = index %4, %27
  %20 = binary mul %19, 2:w10
  br for.body.2.any(%27, %26, %20)
seq.exit.any:
  ret %26
for.body.2.any(%23: item, %24: item, %25: item):
  %26 = binary add %24, %25
  %27 = binary add.one %23, 1:w0
  %28 = call LEN native %4
  %29 = for.test %27, %28, 1:w0
  cond_br %29, for.body.any, seq.exit.any
for.body.subst:
  %31 = subst.value %12
  br for.body.2.any(%6, %7, %31)
}

function SUM.byref internal params 1 {
  $f0 = frame 0 "A"
entry:
  br for.test(1:w10, 0:w10)
for.test(%1: item, %2: item):
  %3 = load $f0 maybe_ref
  %4 = call LEN native %3
  %5 = for.test %1, %4, 1:w0
  cond_br %5, for.body, seq.exit
for.body:
  %7 = load $f0 maybe_ref
  %8 = index %7, %1
  %9 = binary mul %8, 2:w10
  %10 = subst.check %9
  cond_br %10, for.body.subst, for.body.2
seq.exit:
  ret %2
for.body.2:
  %13 = binary add %2, %9
  %14 = binary add.one %1, 1:w0
  br for.test(%14, %13)
for.body.any:
  %16 = load $f0 maybe_ref
  %17 = index %16, %25
  %18 = binary mul %17, 2:w10
  br for.body.2.any(%25, %24, %18)
seq.exit.any:
  ret %24
for.body.2.any(%21: item, %22: item, %23: item):
  %24 = binary add %22, %23
  %25 = binary add.one %21, 1:w0
  %26 = load $f0 maybe_ref
  %27 = call LEN native %26
  %28 = for.test %25, %27, 1:w0
  cond_br %28, for.body.any, seq.exit.any
for.body.subst:
  %30 = subst.value %9
  br for.body.2.any(%1, %2, %30)
}
