  br each.test(i64 0)
each.test(%19: i64):
  %20 = i.add %19, i64 1
  %21 = enum.len %16
  %22 = i.cmp le %20, %21
  cond_br %22, each.body, each.end
each.body:
  %24 = i.add %19, i64 1
