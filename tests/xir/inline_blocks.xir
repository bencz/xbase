module INLINE_BLOCKS

function MAIN params 1 {
  $f0 = frame 0 "ALIST"
  $f1 = frame 1 shared "N"
  $f3 = frame 3 "E"
  $f6 = frame 6 "R"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward MAIN.byref
  ret %2
body:
  %4 = load $f0
  store $f1 maybe_ref, 0:w10
  barrier $f1 maybe_ref
  %7 = ref $f1
  inline.enter MAIN.block5
  store $f6, %7
  %10 = load $f6 maybe_ref
  %11 = binary add.one %10, 1:w0
