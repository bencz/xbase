module INLINE_BLOCKS

function MAIN params 1 {
  $f0 = frame 0 "ALIST"
  $f1 = frame 1 shared "N"
  $f3 = frame 3 "E"
  $f6 = frame 6 "R"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward MAIN.byref
  ret %2
body:
  %4 = load $f0
  store $f1 maybe_ref, 0:w10
  barrier $f1 maybe_ref
  inline.enter MAIN.block4
  %8 = binary mul 2:w10, 1:w10
  %9 = binary add %8, 1:w10
  inline.leave
  %11 = ref $f1
  inline.enter MAIN.block5
  store $f6, %11
  %14 = load $f6 maybe_ref
  %15 = binary add.one %14, 1:w0
  store $f6 maybe_ref, %15
  barrier $f6 maybe_ref
  store $f6, nil
  inline.leave
  %20 = each.source %4, false
  %21 = each.enter $f3, false, %20
  br each.test(i64 0)
each.test(%23: i64):
  %24 = i.add %23, i64 1
  %25 = enum.len %20
  %26 = i.cmp le %24, %25
  cond_br %26, each.body, each.end
each.body:
  %28 = i.add %23, i64 1
  each.move $f3, false, %28
  %30 = load $f3 ref
  inline.enter MAIN.block6
  %32 = binary mul %30, 2:w10
  inline.leave
  store $f3 ref, %32
  barrier $f3 ref
  %36 = i.add %23, i64 1
  br each.test(%36)
each.end:
  each.leave $f3, false, %21
  %39 = load $f1 maybe_ref
  %40 = binary add %39, %9
  ret %40
}

function MAIN.byref internal params 1 {
  $f0 = frame 0 "ALIST"
  $f1 = frame 1 shared "N"
  $f3 = frame 3 "E"
  $f5 = frame 5 "R"
entry:
  store $f1 maybe_ref, 0:w10
  barrier $f1 maybe_ref
  inline.enter MAIN.block1
  %3 = binary mul 2:w10, 1:w10
  %4 = binary add %3, 1:w10
  inline.leave
  %6 = ref $f1
  inline.enter MAIN.block2
  store $f5, %6
  %9 = load $f5 maybe_ref
  %10 = binary add.one %9, 1:w0
  store $f5 maybe_ref, %10
  barrier $f5 maybe_ref
  store $f5, nil
  inline.leave
  %15 = load $f0 maybe_ref
  %16 = each.source %15, false
  %17 = each.enter $f3, false, %16
  br each.test(i64 0)
each.test(%19: i64):
  %20 = i.add %19, i64 1
  %21 = enum.len %16
  %22 = i.cmp le %20, %21
  cond_br %22, each.body, each.end
each.body:
  %24 = i.add %19, i64 1
  each.move $f3, false, %24
  %26 = load $f3 ref
  inline.enter MAIN.block3
  %28 = binary mul %26, 2:w10
  inline.leave
  store $f3 ref, %28
  barrier $f3 ref
  %32 = i.add %19, i64 1
  br each.test(%32)
each.end:
  each.leave $f3, false, %17
  %35 = load $f1 maybe_ref
  %36 = binary add %35, %4
  ret %36
}

