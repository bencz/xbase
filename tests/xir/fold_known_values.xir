module FOLD_KNOWN_VALUES

function MAIN params 0 {
entry:
  inline.enter MUL
  %1 = binary mul 9223372036854775807:w20, 2:w10
  inline.leave
  %3 = binary mod 14:w0, 4:w10
  %4 = array 2.0099999999999998:w0:d2, 12:w0, -3:w0:d1, %1, %3, "gt"
  ret %4
}

function MUL internal params 2 {
  $f0 = frame 0 "A"
  $f1 = frame 1 "B"
entry:
  %0 = load $f0
  %1 = load $f1
  %2 = binary mul %0, %1
  ret %2
}
