module SEQUENCE_TRY

function MAIN params 1 {
  $f0 = frame 0 "X"
  $f1 = frame 1 "X"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward MAIN.byref
  ret %2
body:
  %4 = load $f0
  store $f1, %4
  %6 = block MAIN.block2
  %7 = seq.with %6
  br seq.body
seq.body unwind seq.unwind:
  %9 = load $f1
  %10 = binary add %9, 1:w10
  store $f1, %10
  seq.restore %7
  br seq.join
seq.unwind unwind seq.always.unwind:
  seq.restore %7
  %15 = seq.catch
  cond_br %15, seq.recover, seq.always.unwind
seq.always.unwind:
  %17 = seq.suspend
  %18 = seq.value
  br seq.always.code
seq.join:
  %20 = load $f1
  %21 = call QOUT native %20
  %22 = load $f1
  ret %22
seq.recover unwind seq.always.unwind:
  %24 = seq.value
  br seq.always.exit
seq.always.exit:
  %26 = load $f1
  %27 = call QOUT native %26
  br seq.exit
seq.exit unwind seq.always.unwind:
  ret 0:w10
seq.always.code unwind seq.always.resume:
  %30 = load $f1
  %31 = call QOUT native %30
  br seq.always.resume
seq.always.resume:
  seq.resume %17, %18
  ret
}

function MAIN.byref internal params 1 {
  $f0 = frame 0 "X"
entry:
  %0 = block MAIN.block1
  %1 = seq.with %0
  br seq.body
seq.body unwind seq.unwind:
  %3 = load $f0 maybe_ref
  %4 = binary add %3, 1:w10
  store $f0 maybe_ref, %4
  barrier $f0 maybe_ref
  seq.restore %1
  br seq.join
seq.unwind unwind seq.always.unwind:
  seq.restore %1
  %10 = seq.catch
  cond_br %10, seq.recover, seq.always.unwind
seq.always.unwind:
  %12 = seq.suspend
  %13 = seq.value
  br seq.always.code
seq.join:
  %15 = load $f0 maybe_ref
  %16 = call QOUT native %15
  %17 = load $f0 maybe_ref
  ret %17
seq.recover unwind seq.always.unwind:
  %19 = seq.value
  br seq.always.exit
seq.always.exit:
  %21 = load $f0 maybe_ref
  %22 = call QOUT native %21
  br seq.exit
seq.exit unwind seq.always.unwind:
  ret 0:w10
seq.always.code unwind seq.always.resume:
  %25 = load $f0 maybe_ref
  %26 = call QOUT native %25
  br seq.always.resume
seq.always.resume:
  seq.resume %12, %13
  ret
}

block MAIN.block1 internal params 1 {
  $f0 = frame 0 "E"
entry:
  %0 = load $f0 maybe_ref
  %1 = call BREAK native %0
  ret %1
}

block MAIN.block2 internal params 1 {
  $f0 = frame 0 "E"
entry:
  %0 = load $f0 maybe_ref
  %1 = call BREAK native %0
  ret %1
}
