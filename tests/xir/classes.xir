module CLASSES

function MAIN params 0 {
  $f0 = frame 0 shared "SELF"
entry:
  inline.enter TFOO
  %1 = class.new 0
  inline.leave
  %3 = send NEW %1
  inline.enter TFOO:GET %3
  store $f0, %3
  %6 = block TFOO:GET.block1 $f0
  %7 = load $f0 maybe_ref
  %8 = send GET super 0 %7
  %9 = binary add %6, %8
  store $f0, nil
  inline.leave
  %12 = call QOUT native %9
  ret
}

function TFOO:GET internal params 1 method {
  $f0 = frame 0 shared "SELF"
entry:
  %0 = block TFOO:GET.block1 $f0
  %1 = load $f0 maybe_ref
  %2 = send GET super 0 %1
  %3 = binary add %0, %2
  ret %3
}

function TFOO params 0 {
entry:
  %0 = class.new 0
  ret %0
}

function TFOO:(INIT) internal params 0 {
entry:
  %0 = array 1:w10
  ret %0
}

function TBAR:GET internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward TBAR:GET.byref
  ret %2
body:
  ret 2:w10
}

function TBAR params 0 {
entry:
  %0 = class.new 1
  ret %0
}

block TFOO:GET.block1 internal params 0 {
  $c0 = capture 0 "SELF"
entry:
  %0 = load $c0 maybe_ref
  %1 = send A from 0 %0
  ret %1
}

function TBAR:GET.byref internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  ret 2:w10
}
