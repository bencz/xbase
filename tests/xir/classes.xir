module CLASSES

function MAIN params 0 {
  $f0 = frame 0 shared "SELF"
entry:
  inline.enter TFOO
  %1 = class.new 0
  inline.leave
  inline.enter TFOO:GET %1
  store $f0, %1
  %5 = block TFOO:GET.block1 $f0
  %6 = load $f0 maybe_ref
  %7 = send GET super 0 %6
  %8 = binary add %5, %7
  store $f0, nil
  inline.leave
  %11 = call QOUT native %8
  ret
}

function TFOO:GET internal params 1 method {
  $f0 = frame 0 shared "SELF"
entry:
  %0 = block TFOO:GET.block1 $f0
  %1 = load $f0 maybe_ref
  %2 = send GET super 0 %1
  %3 = binary add %0, %2
  ret %3
}

function TFOO params 0 {
entry:
  %0 = class.new 0
  ret %0
}

function TFOO:(INIT) internal params 0 {
entry:
  %0 = array 1:w10
  ret %0
}

function TBAR:GET internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  %0 = params.ref $f0
  cond_br %0, byref, body
byref:
  %2 = call.forward TBAR:GET.byref
  ret %2
body:
  ret 2:w10
}

function TBAR params 0 {
entry:
  %0 = class.new 1
  ret %0
}

block TFOO:GET.block1 internal params 0 {
  $c0 = capture 0 "SELF"
entry:
  %0 = load $c0 maybe_ref
  %1 = object.is 0 %0
  cond_br %1, entry.2.resolved, entry.2
entry.2:
  %3 = send A from 0 %0
  br entry.2(%3)
entry.2(%5: item):
  ret %5
entry.2.resolved:
  %7 = object.get 0 %0
  br entry.2(%7)
}

function TBAR:GET.byref internal params 1 method {
  $f0 = frame 0 "SELF"
entry:
  ret 2:w10
}
