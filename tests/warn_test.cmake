# Warning test: xbc must succeed and report the expected warning (its text in <name>.warn), or none when that is empty.
execute_process(COMMAND ${EXE} OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
file(READ ${EXPECTED} expected)
string(STRIP "${expected}" expected)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "xbc failed\nstderr:\n${err}")
endif()
if(expected STREQUAL "")
  string(FIND "${err}" "warning:" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "expected no warning\nstderr:\n${err}")
  endif()
  return()
endif()
string(FIND "${err}" "${expected}" at)
if(at EQUAL -1)
  message(FATAL_ERROR "expected warning not found: ${expected}\nstderr:\n${err}")
endif()
