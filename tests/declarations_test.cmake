# include/rtl.ch must declare exactly the runtime's xBase-callable functions (xbf_NAME in runtime/src).
file(READ ${RTL} decls)
string(REGEX MATCHALL "\nEXTERN FUNCTION [A-Za-z_][A-Za-z0-9_]*" declared "\n${decls}") # declarations start a line
set(names "")
foreach(d ${declared})
  string(REGEX REPLACE "\nEXTERN FUNCTION " "" n "${d}")
  string(TOUPPER "${n}" n)
  list(APPEND names ${n})
endforeach()
file(GLOB_RECURSE sources ${RUNTIME_SRC}/*.c)
set(defined "")
foreach(src ${sources})
  file(READ ${src} text)
  string(REGEX MATCHALL "void[ \t\r\n]+xbf_[A-Z0-9_]+[ \t]*\\(" found "${text}")
  foreach(f ${found})
    string(REGEX REPLACE ".*xbf_([A-Z0-9_]+).*" "\\1" n "${f}")
    list(APPEND defined ${n})
  endforeach()
endforeach()
set(missing ${defined})
list(REMOVE_ITEM missing ${names})
set(extra ${names})
list(REMOVE_ITEM extra ${defined})
if(missing OR extra)
  message(FATAL_ERROR "runtime functions not declared in rtl.ch: ${missing}\ndeclared but not in the runtime: ${extra}")
endif()
