# Compile-failure test: xbc must fail, report the expected message, and report it once.
execute_process(COMMAND ${EXE} OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
file(READ ${EXPECTED} expected)
string(STRIP "${expected}" expected)
if(rc EQUAL 0)
  message(FATAL_ERROR "xbc succeeded, expected a failure\nstderr:\n${err}")
endif()
string(FIND "${err}" "${expected}" at)
if(at EQUAL -1)
  message(FATAL_ERROR "expected message not found: ${expected}\nstderr:\n${err}")
endif()
string(REGEX MATCHALL "error:" errors "${err}")
list(LENGTH errors count)
if(count GREATER 1)
  message(FATAL_ERROR "expected one error, got ${count}\nstderr:\n${err}")
endif()
